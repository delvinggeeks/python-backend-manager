{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "schedule:weekly",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Kolkata",
  "labels": ["maintenance"],
  "automerge": true,
  "platformAutomerge": true,
  "pre-commit": { "enabled": true },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the pinned uv version in any workflow (root + template body)",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Auto-merge every GitHub Actions + pre-commit bump (incl. majors) once the required CI checks pass — the workflow-render gate in .github/workflows/ci.yml makes green real for the template body.",
      "matchManagers": ["github-actions", "pre-commit"],
      "automerge": true
    }
  ]
}
