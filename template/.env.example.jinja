# Copy to .env and fill in. Never commit .env.
APP_NAME={{ project_slug }}
ENVIRONMENT=local
DEBUG=true
LOG_JSON=false

HOST=0.0.0.0
PORT=8000
# JSON array; "*" for local dev only
CORS_ORIGINS=["*"]

# Datastores (only needed with the `db` / `cache` extras).
# These credentials are the ones compose.yaml provisions — both derive from project_slug, so the
# file you copy to .env matches the stack you start. They disagreed before; copying this file
# against the compose database produced an authentication failure.
DATABASE_URL=postgresql+asyncpg://{{ project_slug | replace('-', '_') }}:{{ project_slug | replace('-', '_') }}@localhost:5432/{{ project_slug | replace('-', '_') }}
REDIS_URL=redis://localhost:6379/0

# LLM providers (only needed with `llm` / an agent extra)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model cascade. The defaults are NOT repeated here: they live in exactly one place,
# `Settings.model_fast` / `model_default` / `model_frontier` in src/app/core/config.py, and this
# file used to carry a stale second copy of them. Uncomment a line only to override that default —
# an empty value is not "unset", it overrides the default with an empty string.
# MODEL_FAST=
# MODEL_DEFAULT=
# MODEL_FRONTIER=
