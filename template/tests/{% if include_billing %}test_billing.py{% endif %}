"""Billing & entitlements flow — requires the `db` + `users` + `payments` extras.

Proves the security + correctness contract without any live Stripe calls: a forged webhook
signature is rejected with 400; a replayed event is an idempotent no-op; `require_feature`
blocks on the free plan and allows on the right plan; and checkout lazily creates the org's
Stripe customer. The Stripe SDK is mocked at the `app.billing.client` seam. Runs against the
throwaway SQLite database from `conftest.pytest_configure`, so it needs no external Postgres.
"""

from __future__ import annotations

import uuid
from typing import Any

import pytest
from httpx import AsyncClient
from sqlalchemy import func, select

from app.billing.client import WebhookVerificationError
from app.billing.models import ProcessedStripeEvent, Subscription
from app.db.models import Base
from app.db.session import SessionFactory, engine
from app.tenancy.models import Membership, Organization  # noqa: F401  (register tables)
from app.users.models import User  # noqa: F401  (registers the `user` table on Base)

# A Stripe customer id we wire onto an org so webhook syncing can find it.
_CUSTOMER_ID = "cus_test_123"


def _subscription_event() -> dict[str, Any]:
    """A minimal `customer.subscription.created` event for `_CUSTOMER_ID`."""
    return {
        "id": "evt_test_123",
        "type": "customer.subscription.created",
        "data": {
            "object": {
                "id": "sub_test_123",
                "customer": _CUSTOMER_ID,
                "status": "active",
                "current_period_end": 1900000000,
                "items": {"data": [{"price": {"id": "price_test"}}]},
            }
        },
    }


@pytest.fixture(autouse=True)
async def _schema() -> None:
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)
        await conn.run_sync(Base.metadata.create_all)
    yield
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)


async def _register_and_login(http: AsyncClient, email: str, password: str) -> tuple[str, str]:
    r = await http.post("/auth/register", json={"email": email, "password": password})
    assert r.status_code == 201, r.text
    user_id = r.json()["id"]
    r = await http.post("/auth/jwt/login", data={"username": email, "password": password})
    assert r.status_code == 200, r.text
    return user_id, r.json()["access_token"]


async def _make_org(http: AsyncClient, auth: dict[str, str]) -> str:
    r = await http.post("/orgs", json={"name": "Acme", "slug": "acme"}, headers=auth)
    assert r.status_code == 201, r.text
    return r.json()["id"]


async def _set_customer_id(org_id: str, customer_id: str) -> None:
    async with SessionFactory() as session:
        org = await session.get(Organization, uuid.UUID(org_id))
        assert org is not None
        org.stripe_customer_id = customer_id
        await session.commit()


async def _count(model: type) -> int:
    async with SessionFactory() as session:
        result = await session.execute(select(func.count()).select_from(model))
        return int(result.scalar_one())


async def test_bad_webhook_signature_returns_400(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    def _raise(payload: bytes, signature: str) -> dict[str, Any]:
        raise WebhookVerificationError("bad signature")

    # Force signature verification to fail, exactly as a forged event would.
    monkeypatch.setattr("app.billing.client.construct_event", _raise)
    r = await client.post(
        "/billing/webhook", content=b"{}", headers={"stripe-signature": "t=1,v1=forged"}
    )
    assert r.status_code == 400, r.text


async def test_duplicate_event_is_idempotent_noop(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    _, token = await _register_and_login(client, "owner@example.com", "s3cret-passw0rd")
    auth = {"Authorization": f"Bearer {token}"}
    org_id = await _make_org(client, auth)
    await _set_customer_id(org_id, _CUSTOMER_ID)

    event = _subscription_event()

    def _return_event(payload: bytes, signature: str) -> dict[str, Any]:
        return event

    monkeypatch.setattr("app.billing.client.construct_event", _return_event)
    headers = {"stripe-signature": "valid"}

    # First delivery handles the event and creates exactly one subscription.
    r = await client.post("/billing/webhook", content=b"{}", headers=headers)
    assert r.status_code == 200, r.text
    assert r.json()["status"] == "ok"

    # Re-delivering the same event id is a no-op — nothing is created twice.
    r = await client.post("/billing/webhook", content=b"{}", headers=headers)
    assert r.status_code == 200, r.text
    assert r.json()["status"] == "duplicate"

    assert await _count(ProcessedStripeEvent) == 1
    assert await _count(Subscription) == 1


async def test_require_feature_blocks_on_free_and_allows_on_paid(client: AsyncClient) -> None:
    _, token = await _register_and_login(client, "owner@example.com", "s3cret-passw0rd")
    auth = {"Authorization": f"Bearer {token}"}
    org_id = await _make_org(client, auth)

    # No subscription -> free plan -> the advanced_analytics route is forbidden.
    r = await client.get(f"/orgs/{org_id}/billing/usage", headers=auth)
    assert r.status_code == 403, r.text

    # Grant an active 'pro' subscription, which includes advanced_analytics.
    async with SessionFactory() as session:
        session.add(
            Subscription(
                organization_id=uuid.UUID(org_id),
                stripe_subscription_id="sub_pro_1",
                status="active",
                plan="pro",
            )
        )
        await session.commit()

    r = await client.get(f"/orgs/{org_id}/billing/usage", headers=auth)
    assert r.status_code == 200, r.text
    assert r.json()["feature"] == "advanced_analytics"


async def test_checkout_session_creates_customer(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    _, token = await _register_and_login(client, "owner@example.com", "s3cret-passw0rd")
    auth = {"Authorization": f"Bearer {token}"}
    org_id = await _make_org(client, auth)

    def _fake_customer(*, name: str, organization_id: str) -> str:
        return _CUSTOMER_ID

    def _fake_checkout(*, customer_id: str, price_id: str) -> dict[str, str]:
        return {"id": "cs_test_1", "url": "https://stripe.test/checkout"}

    monkeypatch.setattr("app.billing.client.create_customer", _fake_customer)
    monkeypatch.setattr("app.billing.client.create_checkout_session", _fake_checkout)

    r = await client.post(
        f"/orgs/{org_id}/billing/checkout-session",
        json={"price_id": "price_test"},
        headers=auth,
    )
    assert r.status_code == 200, r.text
    assert r.json()["url"] == "https://stripe.test/checkout"

    # The org's Stripe customer was created lazily and persisted.
    async with SessionFactory() as session:
        org = await session.get(Organization, uuid.UUID(org_id))
        assert org is not None
        assert org.stripe_customer_id == _CUSTOMER_ID
