async def test_send_email_task_dispatches_through_the_email_port(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    # The worker-side email task forwards to the EmailPort send helper; capture, don't send.
    sent: list[dict[str, Any]] = []

    async def _capture(provider: Any, **kwargs: Any) -> None:
        sent.append(kwargs)

    monkeypatch.setattr("app.email.send.send_template", _capture)
    await tasks.send_email_task(
        {},
        to="new@example.com",
        subject="Welcome",
        template="welcome",
        context={"email": "new@example.com"},
    )
    assert sent[0]["to"] == "new@example.com"
    assert sent[0]["template"] == "welcome"


async def test_user_manager_enqueues_welcome_instead_of_sending_inline(
    fake_pool: _FakePool, monkeypatch: pytest.MonkeyPatch
) -> None:
    # With jobs + email both on, on_after_register ENQUEUES the welcome email rather than
    # sending it inline — so a slow/failing provider can't delay or break registration.
    from app.users.manager import UserManager

    def _fail_inline() -> Any:
        raise AssertionError("email must be enqueued, not sent inline")

    # If the inline path ran it would resolve the provider and blow up here.
    monkeypatch.setattr("app.email.provider.get_email_provider", _fail_inline)

    class _User:
        email = "new@example.com"

    manager = UserManager.__new__(UserManager)  # skip DB wiring; the hook needs no state
    await manager.on_after_register(_User())  # type: ignore[arg-type]

    function, _args, kwargs = fake_pool.jobs[0]
    assert function == "send_email_task"
    assert kwargs["to"] == "new@example.com"
    assert kwargs["template"] == "welcome"
