def test_secret_columns_are_redacted() -> None:
    from app.admin.views import UserAdmin

    def shown(view: type) -> set[str]:
        return set(view.column_list)

    def hidden(view: type) -> set[str]:
        return set(view.column_details_exclude_list)

    # The password hash appears in neither the list nor the detail page.
    assert "hashed_password" not in shown(UserAdmin)
    assert "hashed_password" in hidden(UserAdmin)
{% if include_api_keys %}
    from app.admin.views import ApiKeyAdmin

    assert "hashed_secret" not in shown(ApiKeyAdmin)
    assert "hashed_secret" in hidden(ApiKeyAdmin)
{% endif %}
{% if include_webhooks %}
    from app.admin.views import WebhookEndpointAdmin

    assert "secret" not in shown(WebhookEndpointAdmin)
    assert "secret" in hidden(WebhookEndpointAdmin)
{% endif %}
{% if include_billing %}
    from app.admin.views import OrganizationAdmin, SubscriptionAdmin

    assert "provider_subscription_id" not in shown(SubscriptionAdmin)
    assert "provider_subscription_id" in hidden(SubscriptionAdmin)
    assert "payments_customer_id" not in shown(OrganizationAdmin)
    assert "payments_customer_id" in hidden(OrganizationAdmin)
{% endif %}


async def test_user_list_page_redacts_password_hash(client: AsyncClient) -> None:
    hashed = await _seed_user("root3@example.com", superuser=True)
    await client.post("/admin/login", data={"username": "root3@example.com", "password": _PASSWORD})
    r = await client.get("/admin/user/list")
    assert r.status_code == 200
    assert "root3@example.com" in r.text  # the row renders ...
    assert hashed not in r.text  # ... but the stored password hash is never in the HTML
