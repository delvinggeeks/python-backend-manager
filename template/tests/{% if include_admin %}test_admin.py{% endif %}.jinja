_PASSWORD = "sup3r-s3cret-passw0rd"


@pytest.fixture(autouse=True)
async def _schema() -> None:
    # Every mapped table exists so the panel (and its dashboard) never queries a missing table.
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)
        await conn.run_sync(Base.metadata.create_all)
    yield
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)


async def _seed_user(email: str, *, superuser: bool, password: str = _PASSWORD) -> str:
    """Insert a user (hashing the password as fastapi-users does) and return the stored hash."""
    hashed = PasswordHelper().hash(password)
    async with SessionFactory() as session:
        session.add(
            User(
                email=email,
                hashed_password=hashed,
                is_active=True,
                is_superuser=superuser,
                is_verified=True,
            )
        )
        await session.commit()
    return hashed


async def test_admin_panel_is_mounted(client: AsyncClient) -> None:
    # The login page is served, so the panel is mounted ...
    r = await client.get("/admin/login")
    assert r.status_code == 200


async def test_admin_requires_authentication(client: AsyncClient) -> None:
    # ... but it is NOT open: an unauthenticated request is redirected to the login page.
    r = await client.get("/admin/")
    assert r.status_code in (302, 303, 307)
    assert "/admin/login" in r.headers.get("location", "")


async def test_superuser_can_sign_in(client: AsyncClient) -> None:
    await _seed_user("root@example.com", superuser=True)
    r = await client.post(
        "/admin/login", data={"username": "root@example.com", "password": _PASSWORD}
    )
    assert r.status_code in (302, 303)  # a successful login redirects into the panel
    # The session cookie now admits the superuser to the panel itself.
    r = await client.get("/admin/")
    assert r.status_code == 200


async def test_non_superuser_is_rejected(client: AsyncClient) -> None:
    await _seed_user("member@example.com", superuser=False)
    r = await client.post(
        "/admin/login", data={"username": "member@example.com", "password": _PASSWORD}
    )
    assert r.status_code not in (302, 303)  # login refused — no redirect into the panel
    r = await client.get("/admin/")
    assert r.status_code in (302, 303, 307)  # still unauthenticated


async def test_wrong_password_is_rejected(client: AsyncClient) -> None:
    await _seed_user("admin2@example.com", superuser=True)
    r = await client.post(
        "/admin/login", data={"username": "admin2@example.com", "password": "not-the-password"}
    )
    assert r.status_code not in (302, 303)


