async def _login(client: AsyncClient, email: str, password: str) -> dict[str, str]:
    r = await client.post("/auth/register", json={"email": email, "password": password})
    assert r.status_code == 201, r.text
    r = await client.post("/auth/jwt/login", data={"username": email, "password": password})
    assert r.status_code == 200, r.text
    return {"Authorization": f"Bearer {r.json()['access_token']}"}


async def _make_org(client: AsyncClient, auth: dict[str, str]) -> str:
    r = await client.post("/orgs", json={"name": "Acme", "slug": "acme"}, headers=auth)
    assert r.status_code == 201, r.text
    return r.json()["id"]


async def _seed_org_with_endpoint(
    *,
    event_types: str = "member.added",
    active: bool = True,
    secret: str = "topsecret",
    url: str = "https://1.1.1.1/receive",
) -> tuple[uuid.UUID, str, str]:
    """Insert an org + one webhook endpoint directly; return (org_id, endpoint_id, url).

    The default ``url`` is a literal public IP so the SSRF egress guard resolves it to itself
    without DNS — delivery tests stay deterministic and need no network. Pass a private/metadata
    URL to exercise the guard's block path.
    """
    async with SessionFactory() as session:
        org = Organization(name="Acme", slug="acme")
        session.add(org)
        await session.flush()
        endpoint = WebhookEndpoint(
            organization_id=org.id,
            url=url,
            secret=secret,
            event_types=event_types,
            active=active,
        )
        session.add(endpoint)
        await session.commit()
        await session.refresh(endpoint)
        return org.id, str(endpoint.id), url


async def test_webhook_endpoint_crud(client: AsyncClient) -> None:
    auth = await _login(client, "owner@example.com", "s3cret-passw0rd")
    org_id = await _make_org(client, auth)

    r = await client.post(
        f"/orgs/{org_id}/webhooks",
        json={
            "url": "https://hooks.example.com/receive",
            "event_types": ["member.added", "org.updated"],
            "secret": "shh",
        },
        headers=auth,
    )
    assert r.status_code == 201, r.text
    created = r.json()
    assert created["event_types"] == ["member.added", "org.updated"]
    assert created["secret"] == "shh"
    assert created["active"] is True
    endpoint_id = created["id"]

    r = await client.get(f"/orgs/{org_id}/webhooks", headers=auth)
    assert r.status_code == 200, r.text
    assert [e["id"] for e in r.json()] == [endpoint_id]

    r = await client.patch(
        f"/orgs/{org_id}/webhooks/{endpoint_id}", json={"active": False}, headers=auth
    )
    assert r.status_code == 200, r.text
    assert r.json()["active"] is False

    r = await client.delete(f"/orgs/{org_id}/webhooks/{endpoint_id}", headers=auth)
    assert r.status_code == 204, r.text

    r = await client.get(f"/orgs/{org_id}/webhooks/{endpoint_id}", headers=auth)
    assert r.status_code == 404

    async with SessionFactory() as session:
        remaining = (await session.execute(select(WebhookEndpoint))).scalars().all()
    assert remaining == []


async def test_endpoint_secret_is_generated_when_omitted(client: AsyncClient) -> None:
    auth = await _login(client, "owner@example.com", "s3cret-passw0rd")
    org_id = await _make_org(client, auth)
    r = await client.post(
        f"/orgs/{org_id}/webhooks",
        json={"url": "https://hooks.example.com/receive", "event_types": ["member.added"]},
        headers=auth,
    )
    assert r.status_code == 201, r.text
    assert len(r.json()["secret"]) >= 16


async def test_dispatch_enqueues_one_signed_delivery_per_subscribed_endpoint(
    fake_pool: _FakePool,
) -> None:
    # Three endpoints: subscribed+active (delivered), subscribed-but-inactive (skipped),
    # active-but-not-subscribed (skipped). Only the first is enqueued.
    async with SessionFactory() as session:
        org = Organization(name="Acme", slug="acme")
        session.add(org)
        await session.flush()
        session.add_all(
            [
                WebhookEndpoint(
                    organization_id=org.id,
                    url="https://a.example.com/wh",
                    secret="s1",
                    event_types="member.added other.event",
                    active=True,
                ),
                WebhookEndpoint(
                    organization_id=org.id,
                    url="https://b.example.com/wh",
                    secret="s2",
                    event_types="member.added",
                    active=False,
                ),
                WebhookEndpoint(
                    organization_id=org.id,
                    url="https://c.example.com/wh",
                    secret="s3",
                    event_types="org.updated",
                    active=True,
                ),
            ]
        )
        await session.commit()
        org_id = org.id

    async with SessionFactory() as session:
        count = await dispatch(
            session,
            event_type="member.added",
            organization_id=org_id,
            data={"user_id": "u1", "role": "member"},
        )

    assert count == 1
    assert len(fake_pool.jobs) == 1
    function, args, kwargs = fake_pool.jobs[0]
    assert function == "deliver_webhook"
    assert args == ()
    assert kwargs["event_type"] == "member.added"
    assert kwargs["payload"]["data"] == {"user_id": "u1", "role": "member"}


async def test_dispatch_is_best_effort_when_queue_is_dead(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    # A dead queue must not break the triggering request: enqueue swallows the RedisError
    # (returns False), so dispatch enqueues nothing and returns 0 instead of raising.
    org_id, _endpoint_id, _url = await _seed_org_with_endpoint()

    async def _broken_pool() -> Any:
        raise RedisError("redis unreachable")

    monkeypatch.setattr(queue, "get_pool", _broken_pool)
    async with SessionFactory() as session:
        count = await dispatch(
            session,
            event_type="member.added",
            organization_id=org_id,
            data={"user_id": "u1"},
        )
    assert count == 0


async def test_deliver_webhook_posts_signed_payload() -> None:
    _org_id, endpoint_id, url = await _seed_org_with_endpoint(secret="topsecret")
    payload = {"event_type": "member.added", "organization_id": "org", "data": {"x": 1}}

    with respx.mock:
        route = respx.post(url).mock(return_value=httpx.Response(200))
        await deliver_webhook(
            {"job_try": 1},
            endpoint_id=endpoint_id,
            event_type="member.added",
            payload=payload,
        )

    assert route.called
    request = route.calls.last.request
    expected = "sha256=" + sign_payload("topsecret", request.content)
    assert request.headers[SIGNATURE_HEADER] == expected
    assert request.headers["X-Webhook-Event"] == "member.added"
{% if include_audit %}

    async with SessionFactory() as session:
        result = await session.execute(
            select(AuditLog).where(AuditLog.action == "webhook.delivered")
        )
        assert result.scalar_one().target == endpoint_id
{% endif %}


async def test_deliver_webhook_retries_on_failure() -> None:
    _org_id, endpoint_id, url = await _seed_org_with_endpoint()
    payload = {"event_type": "member.added", "organization_id": "org", "data": {}}

    with respx.mock:
        respx.post(url).mock(return_value=httpx.Response(500))
        with pytest.raises(Retry):
            await deliver_webhook(
                {"job_try": 1},
                endpoint_id=endpoint_id,
                event_type="member.added",
                payload=payload,
            )


# --- SSRF egress guard -------------------------------------------------------------------------
# A webhook URL is tenant-controlled, so the worker must refuse to POST to a non-public target.
# Literal IPs resolve to themselves (no DNS), so every case below is deterministic and offline.

_SSRF_BLOCKED_URLS = [
    "http://169.254.169.254/latest/meta-data/",  # cloud-metadata (link-local)
    "http://127.0.0.1/hook",  # IPv4 loopback
    "http://10.0.0.1/hook",  # RFC1918 private
    "http://192.168.1.10/hook",  # RFC1918 private
    "http://172.16.5.4/hook",  # RFC1918 private
    "http://100.64.0.1/hook",  # CGNAT (RFC 6598)
    "http://0.0.0.0/hook",  # unspecified
    "http://[::1]/hook",  # IPv6 loopback
    "http://[fd00::1]/hook",  # IPv6 unique-local
    "http://[::ffff:10.0.0.1]/hook",  # IPv4-mapped private (bypass attempt)
    "ftp://1.1.1.1/hook",  # unsupported scheme
    "https:///hook",  # missing host
    "http://example.com:notaport/hook",  # malformed port — must fail closed, not crash
]


@pytest.mark.parametrize("url", _SSRF_BLOCKED_URLS)
async def test_egress_guard_blocks_unsafe_targets(url: str) -> None:
    with pytest.raises(WebhookEgressError):
        await assert_public_url(url)


@pytest.mark.parametrize("url", ["http://1.1.1.1/wh", "https://8.8.8.8/wh"])
async def test_egress_guard_allows_public_targets(url: str) -> None:
    # A globally-routable literal IP passes the guard with no DNS lookup and no network.
    await assert_public_url(url)


async def test_deliver_webhook_blocks_ssrf_target() -> None:
    # An endpoint pointed at the cloud-metadata address must never be POSTed to: the guard blocks
    # delivery before any HTTP call and returns cleanly (no Retry — a private/metadata target is a
    # permanent risk, not a transient failure). respx is armed so a regression that *did* POST is
    # caught hermetically (intercepted, never a real connection) rather than hanging on the network.
    _org_id, endpoint_id, url = await _seed_org_with_endpoint(url="http://169.254.169.254/")
    with respx.mock(assert_all_called=False) as respx_mock:
        route = respx_mock.post(url).mock(return_value=httpx.Response(200))
        await deliver_webhook(
            {"job_try": 1},
            endpoint_id=endpoint_id,
            event_type="member.added",
            payload={"data": {"x": 1}},
        )

    assert not route.called  # blocked before any POST
{% if include_audit %}

    async with SessionFactory() as session:
        result = await session.execute(
            select(AuditLog).where(AuditLog.action == "webhook.delivery_blocked")
        )
        assert result.scalar_one().target == endpoint_id
{% endif %}


async def test_resolve_pinned_target_pins_to_validated_ip(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    # DNS-rebinding defense: a hostname is resolved + validated ONCE, then the connection is pinned
    # to that validated IP literal — the host is never re-resolved, so a nameserver can't swap in a
    # private address afterwards. TLS/cert verification stays bound to the original hostname.
    async def _fake_getaddrinfo(host: str, port: int, **_kw: Any) -> list[Any]:
        assert host == "hooks.tenant.example"
        return [(0, 0, 0, "", ("8.8.8.8", port))]

    monkeypatch.setattr(asyncio.get_running_loop(), "getaddrinfo", _fake_getaddrinfo)

    target = await resolve_pinned_target("https://hooks.tenant.example/wh")
    assert target.url == "https://8.8.8.8/wh"  # dials the validated IP literal (no re-resolution)
    assert target.sni_hostname == "hooks.tenant.example"  # TLS still verifies the real name
    assert target.host_header == "hooks.tenant.example"


async def test_resolve_pinned_target_blocks_rebind_to_private(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    # A public-looking hostname that resolves inward (a rebind to a private IP) is still refused.
    async def _fake_getaddrinfo(_host: str, port: int, **_kw: Any) -> list[Any]:
        return [(0, 0, 0, "", ("10.0.0.5", port))]

    monkeypatch.setattr(asyncio.get_running_loop(), "getaddrinfo", _fake_getaddrinfo)

    with pytest.raises(WebhookEgressError):
        await resolve_pinned_target("https://hooks.tenant.example/wh")


async def test_deliver_webhook_does_not_follow_redirects() -> None:
    # A 3xx to an internal host must NOT be followed (follow_redirects=False), so a redirect can't
    # reach a private address. Only a 2xx is success: the unfollowed 3xx retries, but the internal
    # location is never requested — the security property under test.
    _org_id, endpoint_id, url = await _seed_org_with_endpoint()  # public literal-IP seed
    with respx.mock(assert_all_called=False) as respx_mock:
        outbound = respx_mock.post(url).mock(
            return_value=httpx.Response(302, headers={"Location": "http://169.254.169.254/"})
        )
        internal = respx_mock.get("http://169.254.169.254/").mock(return_value=httpx.Response(200))
        with pytest.raises(Retry):
            await deliver_webhook(
                {"job_try": 1},
                endpoint_id=endpoint_id,
                event_type="member.added",
                payload={"data": {}},
            )

    assert outbound.called  # POSTed once to the public endpoint
    assert not internal.called  # never chased the redirect to the internal host
