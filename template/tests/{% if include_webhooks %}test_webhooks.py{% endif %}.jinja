class _FakePool:
    """Stand-in for the arq Redis pool: records enqueue_job calls instead of hitting Redis."""

    def __init__(self) -> None:
        self.jobs: list[tuple[str, tuple[Any, ...], dict[str, Any]]] = []

    async def enqueue_job(self, function: str, *args: Any, **kwargs: Any) -> None:
        self.jobs.append((function, args, kwargs))


@pytest.fixture
def fake_pool(monkeypatch: pytest.MonkeyPatch) -> _FakePool:
    """Patch the enqueue seam's pool getter so dispatch records instead of touching Redis."""
    pool = _FakePool()

    async def _get_pool() -> _FakePool:
        return pool

    monkeypatch.setattr(queue, "get_pool", _get_pool)
    return pool


