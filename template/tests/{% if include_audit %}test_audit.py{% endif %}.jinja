"""Audit-log tests — requires the `db` extra (and `users` once tenancy is on).

Proves the core contract at the DB seam: :func:`app.audit.record` appends a row, ``**meta`` is
stored as JSON, and the log only ever grows (append-only). The HTTP layer is then exercised
through the read-only list endpoint, including that no write route exists. Runs against the
throwaway SQLite database from `conftest.pytest_configure`, so it needs no external Postgres.
"""

from __future__ import annotations

import pytest
from httpx import AsyncClient
from sqlalchemy import func, select

from app.audit import record
from app.audit.models import AuditLog
from app.db.models import Base
from app.db.session import SessionFactory, engine
