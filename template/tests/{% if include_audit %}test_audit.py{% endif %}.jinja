async def test_audit_read_endpoint_is_not_mounted_without_an_identity_capability(
    client: AsyncClient,
) -> None:
    """No identity capability -> no readable audit log, at all.

    Found by the route-coverage gate on its first full-matrix run: the flat GET /audit attached its
    auth dependency only when users/admin shipped, so an audit-only service published its entire
    append-only log — actor, action, target, metadata — to anonymous callers. The endpoint is now
    absent rather than unauthenticated, and this test pins that so the mounting condition cannot
    silently widen. Writing is unaffected: `record` still appends.
    """
    response = await client.get("/audit")
    assert response.status_code == 404, (
        f"GET /audit answered {response.status_code} in a service with no identity capability — "
        "an anonymously-readable audit log is a disclosure of the security record itself"
    )
