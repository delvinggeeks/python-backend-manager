async def _login(client: AsyncClient, email: str, password: str) -> dict[str, str]:
    r = await client.post("/auth/register", json={"email": email, "password": password})
    assert r.status_code == 201, r.text
    r = await client.post("/auth/jwt/login", data={"username": email, "password": password})
    assert r.status_code == 200, r.text
    return {"Authorization": f"Bearer {r.json()['access_token']}"}


async def _make_org(client: AsyncClient, auth: dict[str, str]) -> str:
    r = await client.post("/orgs", json={"name": "Acme", "slug": "acme"}, headers=auth)
    assert r.status_code == 201, r.text
    return r.json()["id"]


async def test_org_created_event_is_recorded_and_listed(client: AsyncClient) -> None:
    # Creating an org records an "organization.created" audit event via the tenancy flow hook;
    # the org owner (>= admin) can then read it back from the org-scoped list endpoint.
    auth = await _login(client, "owner@example.com", "s3cret-passw0rd")
    org_id = await _make_org(client, auth)

    r = await client.get(f"/orgs/{org_id}/audit", headers=auth)
    assert r.status_code == 200, r.text
    body = r.json()
    created = next(i for i in body["items"] if i["action"] == "organization.created")
    assert created["organization_id"] == org_id
    assert created["target"] == org_id


async def test_org_audit_log_is_append_only(client: AsyncClient) -> None:
    auth = await _login(client, "owner@example.com", "s3cret-passw0rd")
    org_id = await _make_org(client, auth)

    # Read-only: only GET is mounted, so writes are 405 Method Not Allowed.
    r = await client.post(f"/orgs/{org_id}/audit", json={}, headers=auth)
    assert r.status_code == 405
    r = await client.delete(f"/orgs/{org_id}/audit", headers=auth)
    assert r.status_code == 405
