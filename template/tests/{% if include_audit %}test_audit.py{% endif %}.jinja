async def test_flat_audit_endpoint_lists_recorded_events(client: AsyncClient) -> None:
    async with SessionFactory() as session:
        await record(session, "thing.one", actor="sys")
        await record(session, "thing.two", actor="sys")
        await session.commit()
    reg = {"email": "reader@example.com", "password": "s3cret-passw0rd"}
    r = await client.post("/auth/register", json=reg)
    assert r.status_code == 201, r.text
    r = await client.post(
        "/auth/jwt/login", data={"username": reg["email"], "password": reg["password"]}
    )
    headers = {"Authorization": f"Bearer {r.json()['access_token']}"}
    r = await client.get("/audit", headers=headers)
    assert r.status_code == 200, r.text
    body = r.json()
    assert body["total"] == 2
    actions = {item["action"] for item in body["items"]}
    assert {"thing.one", "thing.two"} <= actions


async def test_flat_audit_log_is_append_only(client: AsyncClient) -> None:
    reg = {"email": "writer@example.com", "password": "s3cret-passw0rd"}
    r = await client.post("/auth/register", json=reg)
    assert r.status_code == 201, r.text
    r = await client.post(
        "/auth/jwt/login", data={"username": reg["email"], "password": reg["password"]}
    )
    headers = {"Authorization": f"Bearer {r.json()['access_token']}"}
    # Read-only: only GET is mounted, so writes are 405 Method Not Allowed.
    r = await client.post("/audit", json={}, headers=headers)
    assert r.status_code == 405
    r = await client.delete("/audit", headers=headers)
    assert r.status_code == 405
