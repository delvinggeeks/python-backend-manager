@pytest.fixture(autouse=True)
async def _schema() -> None:
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)
        await conn.run_sync(Base.metadata.create_all)
    yield
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)


async def test_record_persists_an_event() -> None:
    async with SessionFactory() as session:
        entry = await record(
            session, "thing.happened", actor="alice", target="resource-1", reason="testing"
        )
        await session.commit()
        assert entry.id is not None

    async with SessionFactory() as session:
        result = await session.execute(select(AuditLog).where(AuditLog.action == "thing.happened"))
        row = result.scalar_one()
    assert row.actor == "alice"
    assert row.target == "resource-1"
    assert row.meta == {"reason": "testing"}


async def test_record_without_meta_stores_null() -> None:
    async with SessionFactory() as session:
        await record(session, "plain.event")
        await session.commit()

    async with SessionFactory() as session:
        result = await session.execute(select(AuditLog).where(AuditLog.action == "plain.event"))
        row = result.scalar_one()
    assert row.meta is None


async def test_audit_log_accumulates_append_only() -> None:
    async with SessionFactory() as session:
        await record(session, "first.event", actor="sys")
        await record(session, "second.event", actor="sys")
        await session.commit()

    async with SessionFactory() as session:
        total = await session.scalar(select(func.count()).select_from(AuditLog))
    assert total == 2
