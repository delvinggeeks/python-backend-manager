# A port-shaped fake. Every test that exercises ENFORCEMENT injects one of these at the seam, so no
# test depends on a live Redis (and none can pass for the wrong reason because a dev box has one).


class _DenyAll:
    """Rejects every request; the counters report nothing."""

    async def hit(self, key: str, *, limit: int, window_seconds: int) -> bool:
        return False

    async def count_failure(self, key: str, *, window_seconds: int) -> int:
        return 0

    async def failure_count(self, key: str) -> int:
        return 0

    async def clear_failures(self, key: str) -> None:
        return None


class _Recorder:
    """Allows everything, but records the keys and budgets it was asked about."""

    def __init__(self) -> None:
        self.calls: list[tuple[str, int, int]] = []

    async def hit(self, key: str, *, limit: int, window_seconds: int) -> bool:
        self.calls.append((key, limit, window_seconds))
        return True

    async def count_failure(self, key: str, *, window_seconds: int) -> int:
        return 0

    async def failure_count(self, key: str) -> int:
        return 0

    async def clear_failures(self, key: str) -> None:
        return None


class _MemoryLimiter:
    """In-memory counters with the real semantics — used for the auth-lockout wiring."""

    def __init__(self) -> None:
        self.failures: dict[str, int] = {}
        self.allow = True

    async def hit(self, key: str, *, limit: int, window_seconds: int) -> bool:
        return self.allow

    async def count_failure(self, key: str, *, window_seconds: int) -> int:
        self.failures[key] = self.failures.get(key, 0) + 1
        return self.failures[key]

    async def failure_count(self, key: str) -> int:
        return self.failures.get(key, 0)

    async def clear_failures(self, key: str) -> None:
        self.failures.pop(key, None)


