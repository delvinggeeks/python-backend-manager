async def test_plan_tier_selects_the_budget(monkeypatch: pytest.MonkeyPatch) -> None:
    """The org's ACTIVE plan picks the budget — the DoD's "plan tiers map to limits"."""
    recorder = _Recorder()
    monkeypatch.setattr(rl, "_limiter", recorder)
    org_id = "2b1f3c44-0d5e-4a7b-9c81-6e2d5a4f3b90"
    rl._PLAN_CACHE[org_id] = ("pro", time.monotonic() + 300)
    _app, transport = _org_scoped_client()

    async with AsyncClient(transport=transport, base_url="http://test") as ac:
        await ac.get(f"/orgs/{org_id}/thing")

    _key, limit, window = recorder.calls[0]
    assert (limit, window) == (PLAN_TIERS["pro"].limit, PLAN_TIERS["pro"].window_seconds)
    assert limit != default_tier().limit  # proves the plan, not the fallback, chose it


async def test_plan_is_read_from_the_database_and_then_cached(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """A cache MISS resolves the plan from the subscriptions table, then serves from cache."""
    org_id = uuid.uuid4()
    async with SessionFactory() as session:
        session.add(Organization(id=org_id, name="Acme", slug=f"acme-{org_id.hex[:8]}"))
        session.add(
            Subscription(
                organization_id=org_id,
                provider="stripe",
                provider_subscription_id=f"sub_{org_id.hex[:12]}",
                status="active",
                plan="enterprise",
            )
        )
        await session.commit()

    assert await rl._plan_for_org(str(org_id)) == "enterprise"
    assert rl._PLAN_CACHE[str(org_id)][0] == "enterprise"  # miss populated the cache


async def test_an_inactive_subscription_falls_back_to_free(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """A canceled/past_due subscription must NOT keep its paid budget."""
    org_id = uuid.uuid4()
    async with SessionFactory() as session:
        session.add(Organization(id=org_id, name="Lapsed", slug=f"lapsed-{org_id.hex[:8]}"))
        session.add(
            Subscription(
                organization_id=org_id,
                provider="stripe",
                provider_subscription_id=f"sub_{org_id.hex[:12]}",
