# The literal route-template placeholder, assembled at runtime so the braces never appear as a
# brace pair in this file (it is rendered by the template engine before it is ever a test).
_ORG_PARAM = "{" + "org_id" + "}"


def _plain_client() -> tuple[FastAPI, ASGITransport]:
    """A throwaway app carrying ONLY the limiter dependency.

    Deliberately not the service's own /agent route: that endpoint is authenticated (an
    unauthenticated billable endpoint is a denial-of-wallet surface), so an anonymous request is
    rejected before the limiter runs. These tests are about the limiter, not the auth surface.
    """
    app = FastAPI()

    @app.get("/thing", dependencies=[Depends(rl.rate_limit())])
    async def _thing() -> dict[str, bool]:
        return {"ok": True}

    return app, ASGITransport(app=app)


def _org_scoped_client() -> tuple[FastAPI, ASGITransport]:
    """A throwaway app with an ORG-SCOPED route carrying the dependency (key-shape asserts)."""
    app = FastAPI()

    @app.get("/orgs/{org_id}/thing", dependencies=[Depends(rl.rate_limit())])
    async def _thing(org_id: str) -> dict[str, bool]:
        return {"ok": True}

    return app, ASGITransport(app=app)


def test_redis_adapter_satisfies_the_port() -> None:
    """The default adapter must actually implement RateLimitPort (the swap contract)."""
    assert isinstance(RedisRateLimiter(), RateLimitPort)


# --------------------------------------------------------------------------------------
# Fail-open — the property the whole subsystem is built around.
# --------------------------------------------------------------------------------------


async def test_fails_open_when_no_redis_configured(monkeypatch: pytest.MonkeyPatch) -> None:
    """No REDIS_URL → every call allows, and the counters report 'nothing known'."""
    monkeypatch.delenv("REDIS_URL", raising=False)
    get_settings.cache_clear()
    limiter = RedisRateLimiter()

    # A budget of ONE would reject the second call if anything were actually enforcing.
    assert await limiter.hit("k", limit=1, window_seconds=60) is True
    assert await limiter.hit("k", limit=1, window_seconds=60) is True
    assert await limiter.failure_count("id") == 0
    assert await limiter.count_failure("id", window_seconds=60) == 0
    await limiter.clear_failures("id")  # must not raise


async def test_fails_open_when_redis_is_unreachable(monkeypatch: pytest.MonkeyPatch) -> None:
    """A configured but DEAD Redis must allow traffic, not reject it (the outage path)."""
    # Port 6399 is deliberately not a Redis. The adapter's tight socket timeouts make this fast.
    monkeypatch.setenv("REDIS_URL", "redis://127.0.0.1:6399/0")
    get_settings.cache_clear()
    limiter_module._client = None
    limiter = RedisRateLimiter()

    for _ in range(3):
        assert await limiter.hit("k", limit=1, window_seconds=60) is True
    assert await limiter.failure_count("id") == 0


