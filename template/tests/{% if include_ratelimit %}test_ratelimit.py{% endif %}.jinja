# --------------------------------------------------------------------------------------
# Auth-abuse protection (needs the users capability) — the DoD's login/refresh defense.
# --------------------------------------------------------------------------------------


@pytest.fixture(autouse=True)
async def _schema() -> None:
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)
        await conn.run_sync(Base.metadata.create_all)
    yield
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)


_EMAIL = "throttled@example.com"
_PASSWORD = "s3cret-passw0rd"


async def _register(client: AsyncClient) -> None:
    response = await client.post("/auth/register", json={"email": _EMAIL, "password": _PASSWORD})
    assert response.status_code == 201, response.text


async def test_repeated_failed_logins_lock_the_identity_out(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    """Consecutive bad passwords lock the identity; the lockout answers 429, not 400."""
    fake = _MemoryLimiter()
    monkeypatch.setattr(rl, "_limiter", fake)
    await _register(client)
    threshold = get_settings().ratelimit_lockout_threshold

    for _ in range(threshold):
        response = await client.post(
            "/auth/jwt/login", data={"username": _EMAIL, "password": "wrong-password"}
        )
        assert response.status_code == 400, response.text

    # Threshold reached: the next attempt is refused BEFORE the password is even checked, so even
    # the correct password gets 429 during the cooldown.
    response = await client.post(
        "/auth/jwt/login", data={"username": _EMAIL, "password": _PASSWORD}
    )
    assert response.status_code == 429, response.text
    assert response.headers["Retry-After"] == str(get_settings().ratelimit_lockout_window_seconds)


async def test_successful_login_clears_the_failure_counter(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    fake = _MemoryLimiter()
    monkeypatch.setattr(rl, "_limiter", fake)
    await _register(client)

    response = await client.post(
        "/auth/jwt/login", data={"username": _EMAIL, "password": "wrong-password"}
    )
    assert response.status_code == 400, response.text
    assert sum(fake.failures.values()) == 1

    response = await client.post(
        "/auth/jwt/login", data={"username": _EMAIL, "password": _PASSWORD}
    )
    assert response.status_code == 200, response.text
    assert fake.failures == {}  # a good login resets the streak


async def test_failure_counter_never_stores_the_raw_identity(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    """Emails are hashed before they reach the store — no PII in Redis keys."""
    fake = _MemoryLimiter()
    monkeypatch.setattr(rl, "_limiter", fake)
    await _register(client)

    await client.post("/auth/jwt/login", data={"username": _EMAIL, "password": "nope"})

    assert fake.failures
    assert all(_EMAIL not in key and "@" not in key for key in fake.failures)


async def test_auth_endpoints_are_throttled_per_client(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    """Over the auth tier, /auth/jwt/login answers 429 before it touches the user store."""
    fake = _MemoryLimiter()
    fake.allow = False
    monkeypatch.setattr(rl, "_limiter", fake)

    response = await client.post(
        "/auth/jwt/login", data={"username": _EMAIL, "password": _PASSWORD}
    )
    assert response.status_code == 429, response.text
    assert response.headers["Retry-After"] == str(auth_tier().window_seconds)


async def test_refresh_endpoint_is_throttled_too(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    fake = _MemoryLimiter()
    fake.allow = False
    monkeypatch.setattr(rl, "_limiter", fake)

