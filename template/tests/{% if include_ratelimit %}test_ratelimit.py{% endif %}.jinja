def test_plan_tiers_map_to_budgets() -> None:
    assert tier_for_plan("pro") == PLAN_TIERS["pro"]
    assert tier_for_plan("enterprise").limit > tier_for_plan("pro").limit
    assert tier_for_plan("pro").limit > tier_for_plan("free").limit


def test_unknown_and_absent_plans_fall_back_to_the_default_tier() -> None:
    assert tier_for_plan("no-such-plan") == default_tier()
    assert tier_for_plan(None) == default_tier()


def test_auth_tier_is_tighter_than_the_default_tier() -> None:
    """Login/refresh must be capped harder than ordinary traffic — credential-stuffing defense."""
    assert auth_tier().limit < default_tier().limit


# --------------------------------------------------------------------------------------
# Enforcement: the 429 path, key scoping, and the kill switch.
# --------------------------------------------------------------------------------------


async def test_over_budget_returns_429_with_retry_after(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(rl, "_limiter", _DenyAll())
    _app, transport = _plain_client()

    async with AsyncClient(transport=transport, base_url="http://test") as ac:
        response = await ac.get("/thing")
    assert response.status_code == 429, response.text
    assert response.headers["Retry-After"] == str(default_tier().window_seconds)


async def test_key_is_scoped_by_client_and_route_template(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """Off-org traffic keys on the client IP + the ROUTE TEMPLATE (bounded key cardinality)."""
    recorder = _Recorder()
    monkeypatch.setattr(rl, "_limiter", recorder)
    _app, transport = _plain_client()

    async with AsyncClient(transport=transport, base_url="http://test") as ac:
        await ac.get("/thing")

    assert len(recorder.calls) == 1
    key, limit, window = recorder.calls[0]
    assert key.startswith("ip:")
    assert key.endswith("/thing")
    assert (limit, window) == (default_tier().limit, default_tier().window_seconds)


async def test_disabled_setting_skips_enforcement_entirely(
    client: AsyncClient, monkeypatch: pytest.MonkeyPatch
) -> None:
    """RATELIMIT_ENABLED=false is a real kill switch, even with a deny-all limiter behind it."""
    monkeypatch.setenv("RATELIMIT_ENABLED", "false")
    get_settings.cache_clear()
    monkeypatch.setattr(rl, "_limiter", _DenyAll())
    _app, transport = _plain_client()

    async with AsyncClient(transport=transport, base_url="http://test") as ac:
        response = await ac.get("/thing")
    assert response.status_code != 429, response.text


async def test_org_scoped_requests_key_on_the_org_not_the_client(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """An org-scoped route buckets per ORGANIZATION, and the key holds the route TEMPLATE."""
    recorder = _Recorder()
    monkeypatch.setattr(rl, "_limiter", recorder)
    org_id = "8f14e45f-ceea-467a-9cc0-1f2c4a0b1e77"
    _app, transport = _org_scoped_client()

    async with AsyncClient(transport=transport, base_url="http://test") as ac:
        response = await ac.get(f"/orgs/{org_id}/thing")
    assert response.status_code == 200, response.text

    key, _limit, _window = recorder.calls[0]
    # Bucketed by org, and the concrete id is substituted OUT of the route part, so a million orgs
    # produce one key per route rather than a million keys per route.
    assert key == "org:" + org_id + ":/orgs/" + _ORG_PARAM + "/thing"
