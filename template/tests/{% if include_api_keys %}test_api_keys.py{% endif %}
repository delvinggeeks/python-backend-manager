"""End-to-end API-key flow — requires the `db` + `users` extras.

Proves the security contract: an API key authenticates a protected route just like a JWT;
revoked and expired keys are rejected; and the raw secret is returned only once at creation
and is never persisted in plaintext. Runs against the throwaway SQLite database from
`conftest.pytest_configure`, so it needs no external Postgres.
"""

from __future__ import annotations

import uuid
from datetime import datetime, timedelta

import pytest
import time_machine
from httpx import AsyncClient
from hypothesis import HealthCheck, given, settings
from hypothesis import strategies as st
from sqlalchemy import select

from app.api_keys.models import ApiKey
from app.api_keys.security import generate_key, hash_secret, utcnow, verify_secret
from app.db.models import Base
from app.db.session import SessionFactory, engine
from app.tenancy.models import Membership, Organization  # noqa: F401  (register tables)
from app.users.models import User  # noqa: F401  (registers the `user` table on Base)


