async def _register_and_login(client: AsyncClient, email: str, password: str) -> tuple[str, str]:
    r = await client.post("/auth/register", json={"email": email, "password": password})
    assert r.status_code == 201, r.text
    user_id = r.json()["id"]
    r = await client.post("/auth/jwt/login", data={"username": email, "password": password})
    assert r.status_code == 200, r.text
    return user_id, r.json()["access_token"]


async def _make_org(client: AsyncClient, auth: dict[str, str]) -> str:
    r = await client.post("/orgs", json={"name": "Acme", "slug": "acme"}, headers=auth)
    assert r.status_code == 201, r.text
    return r.json()["id"]


async def test_api_key_authenticates_and_lists_without_secret(client: AsyncClient) -> None:
    _, token = await _register_and_login(client, "owner@example.com", "s3cret-passw0rd")
    auth = {"Authorization": f"Bearer {token}"}
    org_id = await _make_org(client, auth)

    # Mint a key — the full secret is returned exactly once, here.
    r = await client.post(
        f"/orgs/{org_id}/api-keys",
        json={"name": "ci-bot", "scopes": ["items:read"], "expires_in_days": 30},
        headers=auth,
    )
    assert r.status_code == 201, r.text
    created = r.json()
    full_key = created["key"]
    assert full_key.startswith(created["prefix"] + ".")
    assert created["scopes"] == ["items:read"]

    # Listing returns prefixes only — never the secret or the full key.
    r = await client.get(f"/orgs/{org_id}/api-keys", headers=auth)
    assert r.status_code == 200, r.text
    listed = r.json()
    assert [k["prefix"] for k in listed] == [created["prefix"]]
    assert all("key" not in k for k in listed)

    # The key authenticates the protected /whoami route and binds the org.
    r = await client.get("/whoami", headers={"X-API-Key": full_key})
    assert r.status_code == 200, r.text
    principal = r.json()
    assert principal["auth_method"] == "api_key"
    assert principal["organization_id"] == org_id
    assert principal["api_key_id"] == created["id"]
    assert principal["scopes"] == ["items:read"]

    # The same route also accepts a user JWT.
    r = await client.get("/whoami", headers=auth)
    assert r.status_code == 200, r.text
    assert r.json()["auth_method"] == "jwt"

    # No credentials at all is a 401.
    r = await client.get("/whoami")
    assert r.status_code == 401


async def test_revoked_key_is_rejected(client: AsyncClient) -> None:
    _, token = await _register_and_login(client, "owner@example.com", "s3cret-passw0rd")
    auth = {"Authorization": f"Bearer {token}"}
    org_id = await _make_org(client, auth)

    r = await client.post(f"/orgs/{org_id}/api-keys", json={"name": "to-revoke"}, headers=auth)
    assert r.status_code == 201, r.text
    created = r.json()
    full_key = created["key"]

    # It works until revoked.
    r = await client.get("/whoami", headers={"X-API-Key": full_key})
    assert r.status_code == 200, r.text

    r = await client.delete(f"/orgs/{org_id}/api-keys/{created['id']}", headers=auth)
    assert r.status_code == 204, r.text

    # After revocation the same key is rejected.
    r = await client.get("/whoami", headers={"X-API-Key": full_key})
    assert r.status_code == 401


async def test_expired_key_is_rejected(client: AsyncClient) -> None:
    user_id, token = await _register_and_login(client, "owner@example.com", "s3cret-passw0rd")
    auth = {"Authorization": f"Bearer {token}"}
    org_id = await _make_org(client, auth)

    # Insert an already-expired key directly — deterministic, no time travel.
    full_key, prefix, hashed = generate_key()
    async with SessionFactory() as session:
        session.add(
            ApiKey(
                organization_id=uuid.UUID(org_id),
                created_by_user_id=uuid.UUID(user_id),
                name="expired",
                prefix=prefix,
                hashed_secret=hashed,
                expires_at=utcnow() - timedelta(days=1),
            )
        )
        await session.commit()

    r = await client.get("/whoami", headers={"X-API-Key": full_key})
    assert r.status_code == 401


async def test_key_expiry_respects_frozen_time(client: AsyncClient) -> None:
    # Travel ACROSS a fixed expiry boundary with a frozen clock: the key is accepted before its
    # expiry and rejected after — proving the time-based transition, not just a pre-expired row.
    # The key is inserted directly (API-key auth needs no JWT), so the frozen clock only drives the
    # expiry check; a JWT minted at real time would itself look expired under a far-future clock.
    user_id, token = await _register_and_login(client, "owner@example.com", "s3cret-passw0rd")
    org_id = await _make_org(client, {"Authorization": f"Bearer {token}"})

    full_key, prefix, hashed = generate_key()
    async with SessionFactory() as session:
        session.add(
            ApiKey(
                organization_id=uuid.UUID(org_id),
                created_by_user_id=uuid.UUID(user_id),
                name="short-lived",
                prefix=prefix,
                hashed_secret=hashed,
                expires_at=datetime(2030, 1, 2, 0, 0, 0),
            )
        )
        await session.commit()

    with time_machine.travel("2030-01-01 12:00:00", tick=False):  # before expiry
        r = await client.get("/whoami", headers={"X-API-Key": full_key})
        assert r.status_code == 200, r.text

    with time_machine.travel("2030-01-03 00:00:00", tick=False):  # after expiry
        r = await client.get("/whoami", headers={"X-API-Key": full_key})
        assert r.status_code == 401


async def test_secret_is_never_persisted_in_plaintext(client: AsyncClient) -> None:
    _, token = await _register_and_login(client, "owner@example.com", "s3cret-passw0rd")
    auth = {"Authorization": f"Bearer {token}"}
    org_id = await _make_org(client, auth)

    r = await client.post(f"/orgs/{org_id}/api-keys", json={"name": "secret-check"}, headers=auth)
    assert r.status_code == 201, r.text
    created = r.json()
    secret = created["key"].split(".", 1)[1]

    async with SessionFactory() as session:
        result = await session.execute(select(ApiKey).where(ApiKey.prefix == created["prefix"]))
        row = result.scalar_one()

    # Only the hash is stored — the row holds the SHA-256 digest, not the raw secret.
    assert row.hashed_secret != secret
    assert row.hashed_secret == hash_secret(secret)


@settings(suppress_health_check=[HealthCheck.function_scoped_fixture])
@given(secret=st.text(min_size=1))
def test_secret_hash_roundtrip_and_determinism(secret: str) -> None:
    # Property (Hypothesis drives many secrets): a secret verifies against its own hash, hashing is
    # deterministic, and a different secret never verifies against it.
    hashed = hash_secret(secret)
    assert verify_secret(secret, hashed)
    assert hash_secret(secret) == hashed
    assert not verify_secret(secret + "x", hashed)
