async def _register_and_login(http: AsyncClient, email: str, password: str) -> str:
    r = await http.post("/auth/register", json={"email": email, "password": password})
    assert r.status_code == 201, r.text
    r = await http.post("/auth/jwt/login", data={"username": email, "password": password})
    assert r.status_code == 200, r.text
    token: str = r.json()["access_token"]
    return token


async def _make_org(http: AsyncClient, auth: dict[str, str], slug: str) -> str:
    r = await http.post("/orgs", json={"name": slug.title(), "slug": slug}, headers=auth)
    assert r.status_code == 201, r.text
    org_id: str = r.json()["id"]
    return org_id


async def test_presigned_upload_and_tenant_isolation(
    client: AsyncClient, fake_s3: dict[str, bytes]
) -> None:
    token_a = await _register_and_login(client, "a@example.com", "s3cret-passw0rd")
    auth_a = {"Authorization": f"Bearer {token_a}"}
    org_a = await _make_org(client, auth_a, "alpha")

    token_b = await _register_and_login(client, "b@example.com", "s3cret-passw0rd")
    auth_b = {"Authorization": f"Bearer {token_b}"}
    org_b = await _make_org(client, auth_b, "bravo")

    # Org A requests a presigned upload URL; it speaks a relative key but S3 is prefixed.
    r = await client.post(
        f"/orgs/{org_a}/storage/upload-url",
        json={"key": "secret.txt"},
        headers=auth_a,
    )
    assert r.status_code == 200, r.text
    body = r.json()
    assert body["key"] == "secret.txt"
    assert f"orgs/{org_a}/secret.txt" in body["url"]
    assert body["url"].startswith("https://s3.test/")

    # Simulate the client completing the upload (object lands under A's prefix).
    fake_s3[build_key("secret.txt", org_id=org_a)] = b"top-secret"

    # Org A lists and sees its object as a relative key.
    r = await client.get(f"/orgs/{org_a}/storage/objects", headers=auth_a)
    assert r.status_code == 200, r.text
    assert {"key": "secret.txt"} in r.json()["objects"]

    # Org B lists and sees NOTHING — tenant prefixing isolates A's object.
    r = await client.get(f"/orgs/{org_b}/storage/objects", headers=auth_b)
    assert r.status_code == 200, r.text
    assert r.json()["objects"] == []

    # A non-member cannot touch A's org storage (membership dependency -> 404).
    r = await client.get(f"/orgs/{org_a}/storage/objects", headers=auth_b)
    assert r.status_code == 404, r.text

    # Presigned download + delete for A.
    r = await client.get(
        f"/orgs/{org_a}/storage/download-url",
        params={"key": "secret.txt"},
        headers=auth_a,
    )
    assert r.status_code == 200, r.text
    r = await client.delete(
        f"/orgs/{org_a}/storage/objects",
        params={"key": "secret.txt"},
        headers=auth_a,
    )
    assert r.status_code == 204, r.text
    assert build_key("secret.txt", org_id=org_a) not in fake_s3
{% else %}

async def test_storage_endpoints_plain_keys(client: AsyncClient, fake_s3: dict[str, bytes]) -> None:
    # Presigned upload URL for a plain key.
    r = await client.post(
        "/storage/upload-url",
        json={"key": "a.txt", "content_type": "text/plain"},
    )
    assert r.status_code == 200, r.text
    assert r.json()["key"] == "a.txt"
    assert r.json()["url"].startswith("https://s3.test/")

    # Seed an object through the fake, then list + presigned download.
    fake_s3["a.txt"] = b"data"
    r = await client.get("/storage/objects")
    assert r.status_code == 200, r.text
    assert {"key": "a.txt"} in r.json()["objects"]

    r = await client.get("/storage/download-url", params={"key": "a.txt"})
    assert r.status_code == 200, r.text
    assert r.json()["key"] == "a.txt"

    # Delete removes it from the backing store.
    r = await client.delete("/storage/objects", params={"key": "a.txt"})
    assert r.status_code == 204, r.text
    assert "a.txt" not in fake_s3
{% endif %}
