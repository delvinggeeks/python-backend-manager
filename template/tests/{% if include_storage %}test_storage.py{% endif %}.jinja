"""Object-storage flow — requires the `storage` extra. No live S3, no credentials.

The aioboto3 client is replaced at the ``app.storage.client.s3_client`` seam with an
in-memory fake, so these tests exercise the real router + key logic deterministically:
an upload+download round-trips and presigned URLs are returned.
{% if include_tenancy or include_rbac or include_api_keys or include_billing %}
Tenant prefixing isolates one org's objects from another's (a non-member gets 404).
{% else %}
Plain keys are stored verbatim.
{% endif %}
``build_key`` / ``relative_key`` are also unit-tested.
"""

from __future__ import annotations

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
from typing import Any

import pytest
from httpx import AsyncClient

{% if include_tenancy or include_rbac or include_api_keys or include_billing %}
from app.db.models import Base
from app.db.session import engine
{% endif %}
from app.storage import client as storage_client
from app.storage.keys import build_key, relative_key
{% if include_tenancy or include_rbac or include_api_keys or include_billing %}
from app.tenancy.models import Membership, Organization  # noqa: F401  (register tables)
from app.users.models import User  # noqa: F401  (registers the `user` table on Base)
{% endif %}


class _FakeStream:
    """Stand-in for an aioboto3 StreamingBody — only ``read()`` is used."""

    def __init__(self, data: bytes) -> None:
        self._data = data

    async def read(self) -> bytes:
        return self._data


class _FakeS3:
    """A tiny in-memory S3 client mirroring the calls our helpers make."""

    def __init__(self, store: dict[str, bytes]) -> None:
        self._store = store

    async def put_object(self, *, Bucket: str, Key: str, Body: bytes, **kwargs: Any) -> None:
        self._store[Key] = Body

    async def get_object(self, *, Bucket: str, Key: str) -> dict[str, Any]:
        return {"Body": _FakeStream(self._store[Key])}

    async def delete_object(self, *, Bucket: str, Key: str) -> None:
        self._store.pop(Key, None)

    async def list_objects_v2(self, *, Bucket: str, Prefix: str = "") -> dict[str, Any]:
        keys = sorted(k for k in self._store if k.startswith(Prefix))
        return {"Contents": [{"Key": k} for k in keys]}

    async def generate_presigned_url(
        self, ClientMethod: str, *, Params: dict[str, Any], ExpiresIn: int
    ) -> str:
        return f"https://s3.test/{Params['Key']}?op={ClientMethod}&expires={ExpiresIn}"


@pytest.fixture
def fake_s3(monkeypatch: pytest.MonkeyPatch) -> dict[str, bytes]:
    """Replace the aioboto3 seam with an in-memory fake; return its backing store."""
    store: dict[str, bytes] = {}

    @asynccontextmanager
    async def _fake_client() -> AsyncIterator[_FakeS3]:
        yield _FakeS3(store)

    monkeypatch.setattr("app.storage.client.s3_client", _fake_client)
    monkeypatch.setattr("app.storage.client._bucket", lambda: "test-bucket")
    return store


def test_build_key_isolates_tenants() -> None:
    a = build_key("report.csv", org_id="org-a")
    b = build_key("report.csv", org_id="org-b")
    assert a != b
    assert a == "orgs/org-a/report.csv"
    assert relative_key(a, org_id="org-a") == "report.csv"
    # Without tenancy the key is stored verbatim.
    assert build_key("report.csv") == "report.csv"


async def test_put_get_round_trip(fake_s3: dict[str, bytes]) -> None:
    await storage_client.put_object("k/obj.txt", b"hello", content_type="text/plain")
    assert await storage_client.get_object("k/obj.txt") == b"hello"
    assert "k/obj.txt" in await storage_client.list_keys()
    url = await storage_client.presigned_get_url("k/obj.txt", expires_in=60)
    assert url.startswith("https://s3.test/")
    await storage_client.remove_object("k/obj.txt")
    assert await storage_client.list_keys() == []

