"""Cross-tenant isolation via Postgres Row-Level Security — needs Docker (testcontainers).

Proves the P4 backstop directly against Postgres, as a LOW-PRIVILEGE app role (a superuser or
table owner would BYPASS RLS — only ``FORCE ROW LEVEL SECURITY`` + a non-owner role exercises
it). It applies the *same* policy DDL the ``0008_rls`` migration applies, then shows that a
``SELECT`` which omits ``WHERE organization_id`` returns only the current tenant's rows, that a
cross-tenant write is rejected, and that the policy drops cleanly (round-trip). Skipped when
Docker / testcontainers isn't available (e.g. the default SQLite-only test runs).
"""

from __future__ import annotations

import os
import pathlib
import subprocess
import sys
import textwrap
import uuid

import pytest

pytest.importorskip("testcontainers.postgres")

import asyncpg
from testcontainers.postgres import PostgresContainer

# In CI (REQUIRE_DB_TESTS=1) an unstartable container is a FAILURE, not a skip: a security gate
# that can quietly absent itself is not a gate. Locally, without the flag, it still skips so the
# default SQLite-only run stays friction-free. (testcontainers itself is a locked dev dependency,
# so `uv sync` always provides it; the realistic failure is the container, handled in the fixture.)
_REQUIRE_DB_TESTS = os.getenv("REQUIRE_DB_TESTS") == "1"

# The policy DDL mirrors migrations/versions/0008_rls.py (kept in sync deliberately).
_TENANT = "NULLIF(current_setting('app.current_tenant', true), '')"
_POLICY_DDL = (
    "CREATE POLICY tenant_isolation ON rls_probe "
    f"USING (organization_id = {_TENANT}::uuid) "
    f"WITH CHECK ({_TENANT} IS NULL OR organization_id = {_TENANT}::uuid)"
)


@pytest.fixture(scope="module")
def postgres_dsn() -> str:
    """A throwaway Postgres (asyncpg DSN), or skip the module if Docker isn't available.

    Only a *container-start* failure skips — a failure inside a test still fails the test (the
    start/stop is kept out of the test's try/except so real RLS bugs are never masked as skips).
    """
    container = PostgresContainer("postgres:16-alpine")
    try:
        container.start()
    except Exception as exc:  # pragma: no cover - environment-dependent
        if _REQUIRE_DB_TESTS:
            pytest.fail(
                f"REQUIRE_DB_TESTS=1 but Postgres could not start: {exc}. The cross-tenant "
                "isolation suite is a required gate and must not be skipped."
            )
        pytest.skip(f"Docker/testcontainers unavailable: {exc}")
    try:
        # testcontainers yields a SQLAlchemy/psycopg URL; asyncpg wants a plain postgres DSN.
        yield container.get_connection_url().replace("postgresql+psycopg2", "postgresql")
    finally:
        container.stop()


async def test_rls_isolates_a_low_privilege_role(postgres_dsn: str) -> None:
    owner = await asyncpg.connect(postgres_dsn)
    try:
        # As the owner: build a tenant table, apply RLS (incl. FORCE so even the owner is bound),
        # and create a non-superuser, non-owner role that the "app" connects as.
        await owner.execute(
            "CREATE TABLE rls_probe (organization_id uuid NOT NULL, val text NOT NULL)"
        )
        await owner.execute("ALTER TABLE rls_probe ENABLE ROW LEVEL SECURITY")
        await owner.execute("ALTER TABLE rls_probe FORCE ROW LEVEL SECURITY")
        await owner.execute(_POLICY_DDL)
        await owner.execute("CREATE ROLE app_user LOGIN PASSWORD 'app_pw'")
        await owner.execute("GRANT SELECT, INSERT ON rls_probe TO app_user")
    finally:
        await owner.close()

    org_a, org_b = uuid.uuid4(), uuid.uuid4()
    app_dsn = postgres_dsn.split("://", 1)[1].split("@", 1)[1]  # host:port/db
    app = await asyncpg.connect(f"postgresql://app_user:app_pw@{app_dsn}")
    try:
        # No tenant context yet → the bootstrapping WITH CHECK allows seeding both tenants.
        await app.execute(
            "INSERT INTO rls_probe (organization_id, val) VALUES ($1, 'a'), ($2, 'b')",
            org_a,
            org_b,
        )
        # Become tenant A, then read WITHOUT a WHERE clause: RLS must hide tenant B's row.
        await app.execute("SELECT set_config('app.current_tenant', $1, false)", str(org_a))
        rows = await app.fetch("SELECT organization_id FROM rls_probe")
        assert {r["organization_id"] for r in rows} == {org_a}, "RLS leaked another tenant's rows"

        # Write isolation: as tenant A, inserting a row tagged for tenant B is rejected.
        with pytest.raises(asyncpg.PostgresError):
            await app.execute(
                "INSERT INTO rls_probe (organization_id, val) VALUES ($1, 'x')", org_b
            )
    finally:
        await app.close()

    # Round-trip: dropping the policy + disabling RLS makes both rows visible again.
    owner = await asyncpg.connect(postgres_dsn)
    try:
        await owner.execute("DROP POLICY tenant_isolation ON rls_probe")
        await owner.execute("ALTER TABLE rls_probe DISABLE ROW LEVEL SECURITY")
        await owner.execute("GRANT SELECT ON rls_probe TO app_user")
    finally:
        await owner.close()

    app = await asyncpg.connect(f"postgresql://app_user:app_pw@{app_dsn}")
    try:
        await app.execute("SELECT set_config('app.current_tenant', $1, false)", str(org_a))
        rows = await app.fetch("SELECT organization_id FROM rls_probe")
        assert {r["organization_id"] for r in rows} == {org_a, org_b}, "RLS did not round-trip"
    finally:
        await app.close()


async def test_bypassrls_role_is_never_scoped(postgres_dsn: str) -> None:
    # The dual-role's trusted half: the privileged role (used by API-key auth / admin / inbound
    # webhooks / workers via get_privileged_session) has BYPASSRLS, so it sees EVERY tenant's rows
    # with no GUC set — those cross-tenant flows are never blocked, while the RLS role stays a
    # strict backstop. This is what lets RLS be FORCE'd without breaking the app.
    org_a, org_b = uuid.uuid4(), uuid.uuid4()
    owner = await asyncpg.connect(postgres_dsn)
    try:
        await owner.execute(
            "CREATE TABLE rls_probe2 (organization_id uuid NOT NULL, val text NOT NULL)"
        )
        await owner.execute("ALTER TABLE rls_probe2 ENABLE ROW LEVEL SECURITY")
        await owner.execute("ALTER TABLE rls_probe2 FORCE ROW LEVEL SECURITY")
        await owner.execute(_POLICY_DDL.replace("rls_probe", "rls_probe2"))
        await owner.execute("CREATE ROLE trusted_user LOGIN PASSWORD 'trusted_pw' BYPASSRLS")
        await owner.execute("GRANT SELECT, INSERT ON rls_probe2 TO trusted_user")
        await owner.execute(
            "INSERT INTO rls_probe2 (organization_id, val) VALUES ($1, 'a'), ($2, 'b')",
            org_a,
            org_b,
        )
    finally:
        await owner.close()

    app_dsn = postgres_dsn.split("://", 1)[1].split("@", 1)[1]
    trusted = await asyncpg.connect(f"postgresql://trusted_user:trusted_pw@{app_dsn}")
    try:
        # No tenant GUC set — yet the BYPASSRLS role sees BOTH tenants (the auth/admin/webhook path
        # that the RLS role, with no GUC, would see zero rows for — the bug the dual-role fixes).
        rows = await trusted.fetch("SELECT organization_id FROM rls_probe2")
        assert {r["organization_id"] for r in rows} == {
            org_a,
            org_b,
        }, "BYPASSRLS role was wrongly scoped"
    finally:
        await trusted.close()


# Driven in a subprocess (a fresh import reads DATABASE_URL / DATABASE_URL_PRIVILEGED from the env).
_APP_FLOW = textwrap.dedent(
    """
    import asyncio

    from httpx import ASGITransport, AsyncClient

    from app.main import create_app


    async def main() -> None:
        email, pw = "rls@example.com", "pw-12345678"
        async with AsyncClient(transport=ASGITransport(app=create_app()), base_url="http://t") as c:
            r = await c.post("/auth/register", json={"email": email, "password": pw})
            assert r.status_code == 201, r.text
            r = await c.post("/auth/jwt/login", data={"username": email, "password": pw})
            assert r.status_code == 200, r.text
            auth = {"Authorization": "Bearer " + r.json()["access_token"]}
            # POST /orgs is the empty-GUC bootstrap (writes the org.created audit row).
            r = await c.post("/orgs", json={"name": "Acme", "slug": "acme"}, headers=auth)
            assert r.status_code == 201, r.text
            org_id = r.json()["id"]
            # With API keys present, mint one + auth with it (the lookup that 401'd before).
            r = await c.post("/orgs/" + org_id + "/api-keys", json={"name": "k"}, headers=auth)
            if r.status_code == 404:
                print("FLOW_OK_NO_API_KEYS")
                return
            assert r.status_code == 201, r.text
            r = await c.get("/whoami", headers={"X-API-Key": r.json()["key"]})
            assert r.status_code == 200, r.text
            print("FLOW_OK")

    asyncio.run(main())
    """
)


async def test_app_end_to_end_under_dual_role(postgres_dsn: str) -> None:
    # The matrix runs RLS only on SQLite (a no-op); this runs the REAL migrations + the REAL ASGI
    # app as the two roles on Postgres — catching a policy that references a missing column (alembic
    # fails) and an empty-GUC write (POST /orgs 500s), neither of which is visible on SQLite.
    host_db = postgres_dsn.split("://", 1)[1].split("@", 1)[
        1
    ]  # user:pw@host:port/db → host:port/db
    owner_async = "postgresql+asyncpg://" + postgres_dsn.split("://", 1)[1]

    su = await asyncpg.connect(postgres_dsn)
    try:
        await su.execute("CREATE ROLE app_rls LOGIN PASSWORD 'rls_pw'")
        await su.execute("CREATE ROLE app_bypass LOGIN PASSWORD 'bypass_pw' BYPASSRLS")
    finally:
        await su.close()

    # Apply the real migration chain as the owner — fails loudly if 0008's policy DDL is wrong.
    migrate = subprocess.run(
        ["alembic", "upgrade", "head"],
        env={**os.environ, "DATABASE_URL": owner_async},
        capture_output=True,
        text=True,
    )
    assert migrate.returncode == 0, f"alembic upgrade head failed:\n{migrate.stderr}"

    su = await asyncpg.connect(postgres_dsn)
    try:
        await su.execute("GRANT USAGE ON SCHEMA public TO app_rls, app_bypass")
        await su.execute(
            "GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES "
            "IN SCHEMA public TO app_rls, app_bypass"
        )
    finally:
        await su.close()

    flow = subprocess.run(
        [sys.executable, "-c", _APP_FLOW],
        env={
            **os.environ,
            "DATABASE_URL": f"postgresql+asyncpg://app_rls:rls_pw@{host_db}",
            "DATABASE_URL_PRIVILEGED": f"postgresql+asyncpg://app_bypass:bypass_pw@{host_db}",
            "USERS_JWT_SECRET": "rls-e2e-test-secret",
        },
        capture_output=True,
        text=True,
    )
    assert flow.returncode == 0, f"app flow failed:\nSTDOUT {flow.stdout}\nSTDERR {flow.stderr}"
    assert "FLOW_OK" in flow.stdout, flow.stdout


# ---------------------------------------------------------------------------------------------
# Transaction-scoped tenant context (SECURITY-BASELINE layer 3).
#
# `set_config(..., false)` is SESSION-scoped: the value lives on the physical connection until it
# is overwritten or the connection closes. Under a transaction-mode pooler (PgBouncer), a server
# connection is handed to the NEXT client between transactions — so a value set for tenant A is
# still set when tenant B's transaction lands on it. These two tests pin the contract that makes
# that impossible: the context must not outlive the transaction that set it, and it must be
# re-established for every subsequent transaction in the same request.
# ---------------------------------------------------------------------------------------------


def _app_engine(postgres_dsn: str, user: str, password: str):
    """An engine whose pool is exactly ONE connection, so every checkout is the same physical
    connection — which is precisely what a transaction-mode pooler does when it reassigns a
    server connection to the next client. No PgBouncer needed to expose the defect."""
    from sqlalchemy.ext.asyncio import create_async_engine

    host_db = postgres_dsn.split("://", 1)[1].split("@", 1)[1]
    return create_async_engine(
        f"postgresql+asyncpg://{user}:{password}@{host_db}", pool_size=1, max_overflow=0
    )


async def _seed_probe(postgres_dsn: str, table: str, role: str, org: uuid.UUID) -> None:
    owner = await asyncpg.connect(postgres_dsn)
    try:
        await owner.execute(
            f"CREATE TABLE {table} (organization_id uuid NOT NULL, val text NOT NULL)"
        )
        await owner.execute(f"ALTER TABLE {table} ENABLE ROW LEVEL SECURITY")
        await owner.execute(f"ALTER TABLE {table} FORCE ROW LEVEL SECURITY")
        await owner.execute(_POLICY_DDL.replace("rls_probe", table))
        await owner.execute(f"CREATE ROLE {role} LOGIN PASSWORD '{role}_pw'")
        await owner.execute(f"GRANT SELECT, INSERT ON {table} TO {role}")
        await owner.execute(f"INSERT INTO {table} (organization_id, val) VALUES ($1, 'a')", org)
    finally:
        await owner.close()


async def test_tenant_context_does_not_outlive_its_transaction(
    postgres_dsn: str, monkeypatch: pytest.MonkeyPatch
) -> None:
    """A pooled connection must carry NO tenant context into the next transaction.

    Drives the real `app.db.session.get_session` dependency, then hands the same physical
    connection to a consumer that sets no context of its own — the PgBouncer hand-off, and
    equally the privileged/dev-fallback path that never sets a GUC.
    """
    from sqlalchemy import text as sa_text
    from sqlalchemy.ext.asyncio import async_sessionmaker

    from app.db import session as session_module
    from app.tenancy.rls import current_tenant_id

    org_a = uuid.uuid4()
    await _seed_probe(postgres_dsn, "rls_txn_probe", "txn_user", org_a)
    test_engine = _app_engine(postgres_dsn, "txn_user", "txn_user_pw")
    monkeypatch.setattr(session_module, "engine", test_engine)
    # Mirror the app's own factory construction: the after_begin hook keys off `info["rls_mode"]`,
    # so a factory built without it gets NO tenant context (fails closed — zero rows).
    monkeypatch.setattr(
        session_module,
        "SessionFactory",
        async_sessionmaker(test_engine, expire_on_commit=False, info={"rls_mode": "tenant"}),
    )

    try:
        # --- request 1: tenant A, through the REAL request dependency -------------------------
        token = current_tenant_id.set(str(org_a))
        agen = session_module.get_session()
        session = await agen.__anext__()
        rows = (await session.execute(sa_text("SELECT val FROM rls_txn_probe"))).scalars().all()
        assert rows == ["a"], "tenant A could not read its own row"
        await session.commit()
        await agen.aclose()  # session closed -> the connection returns to the pool
        current_tenant_id.reset(token)

        # --- the SAME connection, next consumer, NO tenant context of its own -----------------
        async with test_engine.connect() as conn:
            leaked = (
                await conn.execute(sa_text("SELECT current_setting('app.current_tenant', true)"))
            ).scalar()
            visible = (await conn.execute(sa_text("SELECT val FROM rls_txn_probe"))).scalars().all()
            # Impact first, mechanism second — the data leak is the finding; the surviving GUC
            # is why it happens.
            assert visible == [], (
                f"CROSS-TENANT READ: a consumer that set no tenant context read {visible} "
                f"because the connection still carried app.current_tenant={leaked!r}"
            )
            assert not leaked, (
                "tenant context survived its transaction on a pooled connection: "
                f"{leaked!r} — a transaction-mode pooler would hand this to the next tenant"
            )
    finally:
        await test_engine.dispose()


async def test_tenant_context_is_re_established_after_a_commit(
    postgres_dsn: str, monkeypatch: pytest.MonkeyPatch
) -> None:
    """The other half of the contract: a second transaction in the SAME request still sees its
    tenant. Transaction-local context is discarded at commit, so the fix must re-set it per
    transaction rather than once per session — this test fails if that regresses."""
    from sqlalchemy import text as sa_text
    from sqlalchemy.ext.asyncio import async_sessionmaker

    from app.db import session as session_module
    from app.tenancy.rls import current_tenant_id

    org_a = uuid.uuid4()
    await _seed_probe(postgres_dsn, "rls_txn_probe2", "txn_user2", org_a)
    test_engine = _app_engine(postgres_dsn, "txn_user2", "txn_user2_pw")
    monkeypatch.setattr(session_module, "engine", test_engine)
    # Mirror the app's own factory construction: the after_begin hook keys off `info["rls_mode"]`,
    # so a factory built without it gets NO tenant context (fails closed — zero rows).
    monkeypatch.setattr(
        session_module,
        "SessionFactory",
        async_sessionmaker(test_engine, expire_on_commit=False, info={"rls_mode": "tenant"}),
    )

    try:
        token = current_tenant_id.set(str(org_a))
        agen = session_module.get_session()
        session = await agen.__anext__()
        first = (await session.execute(sa_text("SELECT val FROM rls_txn_probe2"))).scalars().all()
        assert first == ["a"], "tenant A could not read its own row in the first transaction"
        await session.commit()  # transaction-local context is discarded here

        second = (await session.execute(sa_text("SELECT val FROM rls_txn_probe2"))).scalars().all()
        assert second == ["a"], (
            "tenant context was NOT re-established for the second transaction of the same "
            "request — the caller silently sees zero rows"
        )
        await agen.aclose()
        current_tenant_id.reset(token)
    finally:
        await test_engine.dispose()


def test_every_session_factory_is_tagged_with_an_rls_mode() -> None:
    """Untagged session factories fail CI, not runtime.

    The ``after_begin`` hook keys off ``info["rls_mode"]``; a factory built without it silently gets
    no tenant context. That fails CLOSED (zero rows) rather than open — but silently, and a
    zero-rows read is a confusing way to learn about a construction mistake. So every
    ``async_sessionmaker(...)`` site in the service is checked structurally here instead of being
    left to code review.
    """
    import ast
    import pathlib

    offenders: list[str] = []
    for path in sorted(pathlib.Path("src/app").rglob("*.py")):
        for node in ast.walk(ast.parse(path.read_text())):
            if not isinstance(node, ast.Call):
                continue
            func = node.func
            name = func.id if isinstance(func, ast.Name) else getattr(func, "attr", None)
            if name != "async_sessionmaker":
                continue
            tagged = any(
                kw.arg == "info"
                and isinstance(kw.value, ast.Dict)
                and any(
                    isinstance(key, ast.Constant) and key.value == "rls_mode"
                    for key in kw.value.keys
                )
                for kw in node.keywords
            )
            if not tagged:
                offenders.append(f"{path}:{node.lineno}")

    assert not offenders, (
        "async_sessionmaker(...) built without info={'rls_mode': ...} — these sessions would run "
        f"with no tenant context: {', '.join(offenders)}"
    )


# ---------------------------------------------------------------------------------------------
# Dev/prod parity for the privileged role.
#
# `DATABASE_URL_PRIVILEGED` falls back to `DATABASE_URL` when unset, so a default local stack runs
# "privileged" flows as the ordinary app role. With FORCE RLS that role sees nothing, which the
# fail-fast now reports loudly — but the real fix is for the dev topology to match production. The
# provisioning artifact is a SQL file the compose stack applies at first boot; this test applies
# that same file to a throwaway Postgres and asserts the role it creates is genuinely privileged.
# ---------------------------------------------------------------------------------------------

_INIT_SQL = (
    pathlib.Path(__file__).resolve().parents[1] / "scripts" / "init-db" / "01-privileged-role.sql"
)


async def test_compose_provisions_a_real_bypassrls_role(postgres_dsn: str) -> None:
    """The role the local stack provisions must actually bypass RLS.

    Without this the dev fallback silently makes DATABASE_URL_PRIVILEGED the app role, so every
    trusted cross-tenant flow reads zero rows locally and behaves differently in production — the
    class of divergence that is only ever discovered in production.
    """
    assert _INIT_SQL.exists(), (
        f"{_INIT_SQL} is missing — the compose stack has no way to provision a privileged role, so "
        "DATABASE_URL_PRIVILEGED falls back to the app role and dev does not match production"
    )

    owner = await asyncpg.connect(postgres_dsn)
    try:
        await owner.execute(_INIT_SQL.read_text())
        row = await owner.fetchrow(
            "SELECT rolbypassrls, rolcanlogin FROM pg_roles WHERE rolname = $1", "app_privileged"
        )
        assert row is not None, "the init script did not create the 'app_privileged' role"
        assert row["rolbypassrls"], "'app_privileged' does not have BYPASSRLS"
        assert row["rolcanlogin"], "'app_privileged' cannot log in, so no DSN can use it"

        # Re-running must be safe: compose replays init scripts on any fresh volume, and an
        # operator may apply it by hand against an existing database.
        await owner.execute(_INIT_SQL.read_text())
    finally:
        await owner.close()

# ---------------------------------------------------------------------------------------------
# RLS COVERAGE over the REAL tenant tables.
#
# The tests above prove the RLS MECHANISM against synthetic probe tables. They cannot notice a real
# tenant table that was created without a policy — and a table added without one is invisible
# exactly the way an unauthenticated route was, before the route-coverage gate existed.
#
# This gate enumerates every table carrying `organization_id` from SQLAlchemy metadata and requires
# each to be policy-protected AND force-enabled, or to appear below with a stated reason.
# ---------------------------------------------------------------------------------------------

# Tables that carry `organization_id` and are deliberately NOT under RLS. Adding a line here is the
# review moment: it is the only way to ship a tenant table without a policy.
RLS_EXEMPT_TABLES: dict[str, str] = {
    "memberships": (
        "Cross-tenant BY DESIGN. `GET /orgs` lists the orgs a user belongs to, which spans tenants; "
        "under a single-tenant GUC an RLS policy would return zero rows and break org listing. "
        "Isolation for memberships is enforced at the application layer by get_current_membership."
    ),
}



def _tenant_tables_from_metadata() -> set[str]:
    """Every table carrying `organization_id`, from SQLAlchemy metadata.

    Model modules are imported for their side effect of registering tables on the shared
    ``Base.metadata`` — the same reason ``migrations/env.py`` imports them. Absent modules are
    skipped, so this works in every capability combination without jinja: THIS FILE'S PATH is
    gated, but its content is copied verbatim, so a jinja tag here would land literally.

    Metadata is the right source of truth: a new model with an `organization_id` column is covered
    the moment it exists, with nobody having to remember to add it to a list.
    """
    import contextlib
    import importlib

    from app.db.models import Base

    for module in (
        "app.api_keys.models",
        "app.audit.models",
        "app.billing.models",
        "app.metering.models",
        "app.tenancy.models",
        "app.webhooks.models",
    ):
        with contextlib.suppress(ImportError):
            importlib.import_module(module)

    return {name for name, table in Base.metadata.tables.items() if "organization_id" in table.c}


async def test_every_tenant_table_is_rls_protected(postgres_dsn: str) -> None:
    """Every `organization_id`-bearing table has a policy and FORCE, or is exempted by name.

    Metadata is the source of truth for "is this a tenant table", so a new model with an
    `organization_id` column is covered the moment it exists — nobody has to remember to add it.
    """
    tenant_tables = _tenant_tables_from_metadata()
    assert tenant_tables, "no organization_id-bearing tables found — the enumeration is broken"

    owner_async = "postgresql+asyncpg://" + postgres_dsn.split("://", 1)[1]
    migrate = subprocess.run(
        ["alembic", "upgrade", "head"],
        env={**os.environ, "DATABASE_URL": owner_async},
        capture_output=True,
        text=True,
    )
    assert migrate.returncode == 0, f"alembic upgrade head failed:\n{migrate.stderr}"

    conn = await asyncpg.connect(postgres_dsn)
    try:
        with_policy = {
            r["tablename"] for r in await conn.fetch(
                "SELECT DISTINCT tablename FROM pg_policies WHERE schemaname = 'public'"
            )
        }
        forced = {
            r["relname"] for r in await conn.fetch(
                "SELECT relname FROM pg_class WHERE relrowsecurity AND relforcerowsecurity"
            )
        }
    finally:
        await conn.close()

    unprotected = sorted(
        table
        for table in tenant_tables
        if table not in RLS_EXEMPT_TABLES and not (table in with_policy and table in forced)
    )
    assert not unprotected, (
        f"these tables carry organization_id but are not protected by FORCE'd RLS: {unprotected}. "
        "Either add them to the migration's _TENANT_TABLES, or add them to RLS_EXEMPT_TABLES with "
        "the reason they are deliberately cross-tenant."
    )


async def test_rls_exemptions_are_not_stale(postgres_dsn: str) -> None:
    """An exemption outliving its table pre-approves the next table to reuse the name."""
    tenant_tables = _tenant_tables_from_metadata()
    stale = sorted(name for name in RLS_EXEMPT_TABLES if name not in tenant_tables)
    assert not stale, f"RLS_EXEMPT_TABLES names tables this service does not have: {stale}"
