"""End-to-end users/auth flow + session hardening — requires the `db` + `users` extras.

Registers a user, logs in for an access + refresh token, then exercises rotation, reuse
detection, single + everywhere logout, and the no-Redis denylist degradation. Runs against the
throwaway SQLite database from `conftest.pytest_configure` with NO Redis, so the suite proves
the no-infra path (the JTI denylist no-ops) authenticates, rotates, and revokes correctly.
"""

from __future__ import annotations

import asyncio
import uuid

import pytest
from fastapi_users.db import SQLAlchemyUserDatabase
from httpx import AsyncClient

from app.db.models import Base
from app.db.session import SessionFactory, engine
from app.users.manager import UserManager
from app.users.models import User


@pytest.fixture(autouse=True)
async def _schema() -> None:
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)
        await conn.run_sync(Base.metadata.create_all)
    yield
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.drop_all)


async def _register(client: AsyncClient, email: str, password: str) -> str:
    r = await client.post("/auth/register", json={"email": email, "password": password})
    assert r.status_code == 201, r.text
    return str(r.json()["id"])


async def _login(client: AsyncClient, email: str, password: str) -> tuple[str, str]:
    r = await client.post("/auth/jwt/login", data={"username": email, "password": password})
    assert r.status_code == 200, r.text
    body = r.json()
    return body["access_token"], body["refresh_token"]


async def test_register_login_authenticated(client: AsyncClient) -> None:
    email = "alice@example.com"
    password = "s3cret-passw0rd"

    r = await client.post("/auth/register", json={"email": email, "password": password})
    assert r.status_code == 201, r.text
    assert r.json()["email"] == email

    access, refresh = await _login(client, email, password)
    assert access and refresh  # login now issues an access token AND a rotating refresh token

    r = await client.get("/users/me", headers={"Authorization": f"Bearer {access}"})
    assert r.status_code == 200, r.text
    assert r.json()["email"] == email

    r = await client.get("/users/me")
    assert r.status_code == 401


async def test_refresh_rotates(client: AsyncClient) -> None:
    await _register(client, "bob@example.com", "s3cret-passw0rd")
    _, refresh = await _login(client, "bob@example.com", "s3cret-passw0rd")

    r = await client.post("/auth/jwt/refresh", json={"refresh_token": refresh})
    assert r.status_code == 200, r.text
    rotated = r.json()
    assert rotated["refresh_token"] != refresh  # the refresh token rotated

    # The freshly-minted access token authenticates.
    r = await client.get(
        "/users/me", headers={"Authorization": f"Bearer {rotated['access_token']}"}
    )
    assert r.status_code == 200, r.text

    # The old refresh token is spent — replaying it is rejected.
    r = await client.post("/auth/jwt/refresh", json={"refresh_token": refresh})
    assert r.status_code == 401


async def test_refresh_reuse_detected_revokes_family(client: AsyncClient) -> None:
    await _register(client, "carol@example.com", "s3cret-passw0rd")
    _, r1 = await _login(client, "carol@example.com", "s3cret-passw0rd")

    resp = await client.post("/auth/jwt/refresh", json={"refresh_token": r1})
    assert resp.status_code == 200, resp.text
    r2 = resp.json()["refresh_token"]

    # Replay the spent r1 → reuse (theft) detected → the whole family is revoked.
    resp = await client.post("/auth/jwt/refresh", json={"refresh_token": r1})
    assert resp.status_code == 401

    # r2 was the legitimate current token, but it shares the revoked family — now dead too.
    resp = await client.post("/auth/jwt/refresh", json={"refresh_token": r2})
    assert resp.status_code == 401


async def test_refresh_rotation_is_atomic_under_concurrency(client: AsyncClient) -> None:
    # Race N concurrent refreshes of the SAME token: the atomic claim (conditional UPDATE) must
    # let AT MOST ONE succeed — a stolen token can't be fanned into parallel sessions through a
    # check-then-set window. The invariant under test is "no double-spend".
    await _register(client, "grace@example.com", "s3cret-passw0rd")
    _, refresh = await _login(client, "grace@example.com", "s3cret-passw0rd")

    results = await asyncio.gather(
        *[client.post("/auth/jwt/refresh", json={"refresh_token": refresh}) for _ in range(8)]
    )
    assert sum(r.status_code == 200 for r in results) <= 1, [r.status_code for r in results]


async def test_logout_all_revokes_access_immediately(client: AsyncClient) -> None:
    await _register(client, "dave@example.com", "s3cret-passw0rd")
    access, refresh = await _login(client, "dave@example.com", "s3cret-passw0rd")

    r = await client.get("/users/me", headers={"Authorization": f"Bearer {access}"})
    assert r.status_code == 200

    r = await client.post("/auth/jwt/logout-all", headers={"Authorization": f"Bearer {access}"})
    assert r.status_code == 204, r.text

    # token_version bumped → the same access token is rejected at once, with no Redis involved.
    r = await client.get("/users/me", headers={"Authorization": f"Bearer {access}"})
    assert r.status_code == 401
    # ...and every refresh family is revoked.
    r = await client.post("/auth/jwt/refresh", json={"refresh_token": refresh})
    assert r.status_code == 401


async def test_logout_revokes_refresh_family(client: AsyncClient) -> None:
    await _register(client, "erin@example.com", "s3cret-passw0rd")
    access, refresh = await _login(client, "erin@example.com", "s3cret-passw0rd")

    r = await client.post(
        "/auth/jwt/logout",
        json={"refresh_token": refresh},
        headers={"Authorization": f"Bearer {access}"},
    )
    assert r.status_code == 204, r.text

    # The session's refresh family is revoked — it can no longer be rotated.
    r = await client.post("/auth/jwt/refresh", json={"refresh_token": refresh})
    assert r.status_code == 401


async def test_denylist_noops_without_redis() -> None:
    # No REDIS_URL in the test env → the JTI denylist degrades to a no-op: writes are swallowed
    # and reads fail open, so the no-infra path still authenticates (proven by the flows above).
    from app.users.denylist import deny_jti, is_jti_denied

    await deny_jti("some-jti", 60)  # must not raise
    assert await is_jti_denied("some-jti") is False


async def test_denylist_swallows_unreachable_redis(monkeypatch: pytest.MonkeyPatch) -> None:
    # Redis installed but the server unreachable: the denylist must fail fast + swallow, so auth
    # keeps working. Skipped on legs without the cache/worker extra (redis isn't installed).
    pytest.importorskip("redis")
    from app.core.config import get_settings
    from app.users import denylist

    monkeypatch.setattr(get_settings(), "redis_url", "redis://127.0.0.1:6399")
    monkeypatch.setattr(denylist, "_client", None)
    await denylist.deny_jti("x", 60)  # connection refused is swallowed — no raise
    assert await denylist.is_jti_denied("x") is False  # fails open


async def test_password_reset_invalidates_sessions(client: AsyncClient) -> None:
    # The on_after_reset_password hook must end every session: bump token_version + revoke all
    # refresh families (so a stolen refresh token can't mint new access tokens after a reset).
    user_id = await _register(client, "frank@example.com", "s3cret-passw0rd")
    access, refresh = await _login(client, "frank@example.com", "s3cret-passw0rd")

    async with SessionFactory() as session:
        manager = UserManager(SQLAlchemyUserDatabase(session, User))
        user = await manager.get(uuid.UUID(user_id))
        await manager.on_after_reset_password(user)

    r = await client.get("/users/me", headers={"Authorization": f"Bearer {access}"})
    assert r.status_code == 401
    r = await client.post("/auth/jwt/refresh", json={"refresh_token": refresh})
    assert r.status_code == 401
