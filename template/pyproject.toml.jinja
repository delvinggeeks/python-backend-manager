[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
license = { text = "MIT" }
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
keywords = ["fastapi", "uv", "backend", "ai-agents"]

# CORE — lower bounds only so `uv lock --upgrade` always pulls newest compatible.
dependencies = [
    "fastapi>=0.136",
    "uvicorn[standard]>=0.35",
    "pydantic[email]>=2.13",
    "pydantic-settings>=2.7",
    "httpx>=0.28",
    "structlog>=25.1",
    "tenacity>=9.0",
    "python-multipart>=0.0.20",
]

[project.optional-dependencies]
db = [
    "sqlalchemy[asyncio]>=2.0.36",
    "alembic>=1.14",
    "asyncpg>=0.30",
    "pgvector>=0.3.6",
]
cache = ["redis[hiredis]>=5.2"]
worker = ["arq>=0.26"]
auth = ["pyjwt>=2.10", "argon2-cffi>=23.1", "authlib>=1.4"]
observability = [
    "sentry-sdk[fastapi]>=2.20",
    "logfire>=3.0",
    "opentelemetry-instrumentation-fastapi>=0.50b0",
    "prometheus-fastapi-instrumentator>=7",
{% if include_observability %}
    "opentelemetry-sdk>=1.29",
    "opentelemetry-exporter-otlp-proto-http>=1.29",
    "opentelemetry-instrumentation-httpx>=0.50b0",
    "opentelemetry-instrumentation-sqlalchemy>=0.50b0",
    "opentelemetry-instrumentation-redis>=0.50b0",
{% endif %}
]
llm = [
    "anthropic>=0.109",
    "openai>=2.0",
    "litellm>=1.60",
    "instructor>=1.7",
    "tiktoken>=0.8",
]

# SaaS + agentic capability extras — all non-conflicting; opt in per service.
users = ["fastapi-users[sqlalchemy]>=14"]
# Both provider SDKs ship in the extra (one is active per service via PAYMENTS_PROVIDER) so
# Renovate tracks both regardless of which a given service selects.
payments = ["stripe>=11", "razorpay>=2.0"]
# Both adapters' SDKs ship in the extra (SMTP via aiosmtplib, the Amazon SES API via aioboto3);
# one is active per service via EMAIL_PROVIDER, and jinja2 renders the bodies.
email = ["aioboto3>=14", "aiosmtplib>=3.0", "jinja2>=3.1"]
storage = ["aioboto3>=14"]
admin = ["sqladmin>=0.20"{% if include_admin %}, "itsdangerous>=2.0"{% endif %}]
ratelimit = ["fastapi-limiter>=0.1.6"]
scheduler = ["apscheduler>=3.11"]
api = ["fastapi-pagination>=0.12", "python-slugify>=8"]
rag = ["pypdf>=5", "qdrant-client>=1.12", "semantic-text-splitter>=0.20"]
mcp = ["mcp>=1.2", "fastmcp>=2"]

# Agent frameworks — all defined, but mutually exclusive (see [tool.uv]).
# This service defaults to: {{ agent_framework }}
pydantic-ai = ["pydantic-ai-slim[anthropic,openai]>=1.0"]
langgraph = [
    "langgraph>=1.0",
    "langchain>=1.0",
    "langchain-anthropic>=1.0",
    "langchain-openai>=1.0",
]
openai-agents = ["openai-agents>=0.17"]

[dependency-groups]
dev = [
    "pytest>=8.3",
    "pytest-asyncio>=0.25",
    "pytest-cov>=6.0",
    "anyio>=4.7",
    "ruff>=0.15",
    "mypy>=1.20",
    "vulture>=2.13",
    "xenon>=0.9",
    "import-linter>=2.0",
    "interrogate>=1.7",
    "pre-commit>=4.0",
    "faker>=33.0",
    "polyfactory>=2.18",
    "respx>=0.21",
    "testcontainers>=4.8",
{% if include_db or include_users or include_tenancy or include_rbac or include_api_keys or include_billing or include_audit or include_webhooks or include_admin %}
    "aiosqlite>=0.20",
{% endif %}
]

[tool.uv]
conflicts = [
    [
        { extra = "pydantic-ai" },
        { extra = "langgraph" },
        { extra = "openai-agents" },
    ],
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/app"]

[tool.ruff]
src = ["src", "tests"]
line-length = 100
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
# S = flake8-bandit (Python SAST: hardcoded secrets, SQLi, unsafe deserialize, ...).
select = ["E", "W", "F", "I", "B", "S", "UP", "ASYNC", "RUF", "SIM", "C4"]
ignore = ["B008"]

[tool.ruff.lint.per-file-ignores]
# Tests legitimately hold asserts and hardcoded dummy secrets/passwords.
"tests/*" = ["S101", "S105", "S106", "S107"]

[tool.ruff.format]
docstring-code-format = true

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
plugins = ["pydantic.mypy"]
ignore_missing_imports = true

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
addopts = "-q --cov=src/app --cov-report=term-missing"

[tool.interrogate]
# Docstring-coverage gate (public API stays documented). Run as `uv run interrogate src`.
fail-under = 80
ignore-init-method = true
ignore-magic = true
ignore-nested-functions = true
ignore-private = true
ignore-semiprivate = true
ignore-property-decorators = true
ignore-overloaded-functions = true
exclude = ["tests"]

[tool.vulture]
# Dead-code gate. min_confidence 80 keeps it false-positive-free on FastAPI/Pydantic patterns
# (decorated routes, model fields). Run as `uv run vulture src`.
min_confidence = 80
# `ctx` is arq's job context — its WorkerCoroutine type Protocol REQUIRES that exact parameter
# name, so it can't be `_`-prefixed; it's legitimately unused in trivial tasks/hooks. Narrow name,
# safe to ignore globally (unlike a common name such as `request`, handled by `_`-prefix instead).
ignore_names = ["ctx"]
