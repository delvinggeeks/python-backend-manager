"""Alembic migration environment (async).

The database URL is read from the app settings (pydantic-settings) at run time, so it is
never hard-coded in alembic.ini. ``target_metadata`` is ``app.db.models.Base.metadata``,
so ``alembic revision --autogenerate`` sees every mapped table.
"""

from __future__ import annotations

import asyncio
from logging.config import fileConfig

from alembic import context
from sqlalchemy import pool
from sqlalchemy.engine import Connection
from sqlalchemy.ext.asyncio import async_engine_from_config

{% if include_api_keys %}
from app.api_keys import models as _api_keys_models  # noqa: F401  (registers the api_keys table)
{% endif %}
{% if include_audit %}
from app.audit import models as _audit_models  # noqa: F401  (registers the audit_logs table)
{% endif %}
{% if include_billing %}
from app.billing import models as _billing_models  # noqa: F401  (registers the billing tables)
{% endif %}
from app.core.config import get_settings
from app.db.models import Base
{% if include_idempotency %}
from app.idempotency import models as _idempotency_models  # noqa: F401
{% endif %}
{% if include_tenancy or include_rbac or include_api_keys or include_billing or include_webhooks %}
from app.tenancy import models as _tenancy_models  # noqa: F401  (registers org + membership tables)
{% endif %}
{% if include_users or include_tenancy or include_rbac or include_api_keys or include_billing or include_webhooks or include_admin %}
from app.users import models as _users_models  # noqa: F401  (registers the user table)
{% endif %}
{% if include_webhooks %}
from app.webhooks import models as _webhooks_models  # noqa: F401  (registers webhook_endpoints)
{% endif %}

# Alembic Config object — provides access to values within alembic.ini.
config = context.config

# Configure Python logging from the alembic.ini [loggers]/[handlers]/[formatters].
if config.config_file_name is not None:
    fileConfig(config.config_file_name)

target_metadata = Base.metadata


def _database_url() -> str:
    url = get_settings().database_url
    if not url:
        raise RuntimeError("DATABASE_URL must be set to run database migrations")
    return url


def run_migrations_offline() -> None:
    """Emit migrations as SQL, without a live database connection."""
    context.configure(
        url=_database_url(),
        target_metadata=target_metadata,
        literal_binds=True,
        dialect_opts={"paramstyle": "named"},
        compare_type=True,
    )
    with context.begin_transaction():
        context.run_migrations()


def _do_run_migrations(connection: Connection) -> None:
    context.configure(
        connection=connection,
        target_metadata=target_metadata,
        compare_type=True,
    )
    with context.begin_transaction():
        context.run_migrations()


async def _run_async_migrations() -> None:
    configuration = config.get_section(config.config_ini_section, {})
    configuration["sqlalchemy.url"] = _database_url()
    connectable = async_engine_from_config(
        configuration,
        prefix="sqlalchemy.",
        poolclass=pool.NullPool,
    )
    async with connectable.connect() as connection:
        await connection.run_sync(_do_run_migrations)
    await connectable.dispose()


def run_migrations_online() -> None:
    """Run migrations against a live database via an async engine."""
    asyncio.run(_run_async_migrations())


if context.is_offline_mode():
    run_migrations_offline()
else:
    run_migrations_online()
