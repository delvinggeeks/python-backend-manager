services:
  api:
    build: .
    ports:
      - "8000:8000"
    env_file: .env
{% if include_db or include_cache or include_users or include_tenancy %}
    depends_on:
{% if include_db or include_users or include_tenancy %}
      db:
        condition: service_healthy
{% endif %}
{% if include_cache %}
      redis:
        condition: service_started
{% endif %}
{% endif %}
{% if include_db or include_users or include_tenancy %}
  db:
    image: pgvector/pgvector:pg17
    environment:
      POSTGRES_USER: {{ project_slug | replace('-', '_') }}
      POSTGRES_PASSWORD: {{ project_slug | replace('-', '_') }}
      POSTGRES_DB: {{ project_slug | replace('-', '_') }}
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ project_slug | replace('-', '_') }}"]
      interval: 5s
      timeout: 3s
      retries: 5
{% endif %}
{% if include_cache %}
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
{% endif %}
{% if include_db or include_users or include_tenancy %}
volumes:
  pgdata:
{% endif %}
