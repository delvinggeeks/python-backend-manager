services:
  api:
    build: .
    ports:
      - "8000:8000"
    env_file: .env
{% if include_db or include_cache or include_users or include_tenancy or include_rbac or include_api_keys or include_billing or include_audit or include_webhooks or include_admin %}
    depends_on:
{% if include_db or include_users or include_tenancy or include_rbac or include_api_keys or include_billing or include_audit or include_webhooks or include_admin %}
      db:
        condition: service_healthy
{% endif %}
{% if include_cache %}
      redis:
        condition: service_started
{% endif %}
{% endif %}
{% if include_db or include_users or include_tenancy or include_rbac or include_api_keys or include_billing or include_audit or include_webhooks or include_admin %}
  db:
    image: pgvector/pgvector:pg17
    environment:
      POSTGRES_USER: {{ project_slug | replace('-', '_') }}
      POSTGRES_PASSWORD: {{ project_slug | replace('-', '_') }}
      POSTGRES_DB: {{ project_slug | replace('-', '_') }}
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ project_slug | replace('-', '_') }}"]
      interval: 5s
      timeout: 3s
      retries: 5
{% endif %}
{% if include_cache %}
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
{% endif %}
{% if include_observability %}
  # --- Local observability stack (opt-in) — `docker compose --profile observability up`, or
  #     `just observe`. Point the app at it with OTEL_EXPORTER_OTLP_ENDPOINT (in .env):
  #     http://otel-collector:4318 for the compose `api`, http://localhost:4318 for `just run`.
  #     Grafana (pre-provisioned, anonymous admin): http://localhost:3000.
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.116.0
    profiles: [observability]
    command: ["--config=/etc/otelcol/config.yaml"]
    volumes:
      - ./observability/otel-collector-config.yaml:/etc/otelcol/config.yaml:ro
    ports:
      - "4317:4317"
      - "4318:4318"
    depends_on:
      - tempo
      - loki
      - prometheus
  tempo:
    image: grafana/tempo:2.6.1
    profiles: [observability]
    command: ["-config.file=/etc/tempo.yaml"]
    volumes:
      - ./observability/tempo.yaml:/etc/tempo.yaml:ro
  loki:
    image: grafana/loki:3.3.2
    profiles: [observability]
    command: ["-config.file=/etc/loki/config.yaml"]
    volumes:
      - ./observability/loki-config.yaml:/etc/loki/config.yaml:ro
  prometheus:
    image: prom/prometheus:v3.0.1
    profiles: [observability]
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--web.enable-otlp-receiver"
    volumes:
      - ./observability/prometheus.yml:/etc/prometheus/prometheus.yml:ro
    ports:
      - "9090:9090"
  grafana:
    image: grafana/grafana:11.4.0
    profiles: [observability]
    environment:
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Admin
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
    volumes:
      - ./observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - ./observability/grafana/dashboards:/var/lib/grafana/dashboards:ro
    ports:
      - "3000:3000"
    depends_on:
      - prometheus
      - tempo
      - loki
{% endif %}
{% if include_db or include_users or include_tenancy or include_rbac or include_api_keys or include_billing or include_audit or include_webhooks or include_admin %}
volumes:
  pgdata:
{% endif %}
