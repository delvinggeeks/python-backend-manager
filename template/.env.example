# Copy to .env and fill in. Never commit .env.
APP_NAME=witaura-backend
ENVIRONMENT=local
DEBUG=true
LOG_JSON=false

HOST=0.0.0.0
PORT=8000
# JSON array; "*" for local dev only
CORS_ORIGINS=["*"]

# Datastores (only needed with the `db` / `cache` extras)
DATABASE_URL=postgresql+asyncpg://witaura:witaura@localhost:5432/witaura
REDIS_URL=redis://localhost:6379/0

# LLM providers (only needed with `llm` / an agent extra)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model cascade
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_DEFAULT=claude-sonnet-4-6
MODEL_FRONTIER=claude-opus-4-8
