"""Background task functions — the units of work the arq worker runs.

Each is a plain async function ``(ctx, ...)`` where ``ctx`` is arq's job context. They are
registered in :class:`app.jobs.worker.WorkerSettings` and invoked either by an enqueue
(:func:`app.jobs.queue.enqueue`) or by the cron schedule. Importing this module opens no
connections, so tasks can be unit-tested by calling them directly. Requires the `worker` extra.
"""

from __future__ import annotations

from typing import Any

from app.core.logging import get_logger

log = get_logger(__name__)


async def example_task(ctx: dict[str, Any], value: int) -> int:
    """A trivial example task: double a number. Replace with real background work."""
    log.info("jobs.example_task", value=value)
    return value * 2
{% if include_idempotency %}


async def purge_idempotency_keys(ctx: dict[str, Any]) -> int:
    """Delete expired idempotency keys (storage reclaim). Returns how many were removed.

    The middleware already treats an expired key as absent, so correctness never depends on this —
    it just reclaims storage. Scheduled on the worker cron; a worker-less service can call
    ``SqlIdempotencyStore().purge_expired()`` from its own scheduler instead.
    """
    from app.idempotency.store import SqlIdempotencyStore

    return await SqlIdempotencyStore().purge_expired()
{% endif %}
{% if include_email %}


async def send_email_task(
    ctx: dict[str, Any],
    *,
    to: str | list[str],
    subject: str,
    template: str,
    context: dict[str, Any] | None = None,
) -> None:
    """Send a templated email from the worker — the enqueued counterpart of an inline send.

    Routing mail through the queue means a slow or failing provider can't delay or break the
    request that triggered it. The body is rendered and delivered via the same EmailPort seam.
    """
    from app.email.provider import get_email_provider
    from app.email.send import send_template

    await send_template(
        get_email_provider(), to=to, subject=subject, template=template, context=context
    )
{% endif %}
{% if include_webhooks %}


async def deliver_webhook(
    ctx: dict[str, Any],
    *,
    endpoint_id: str,
    event_type: str,
    payload: dict[str, Any],
) -> None:
    """Deliver one webhook: POST the event to the endpoint, signed with its secret.

    Runs in the worker (never inline) so a slow or failing receiver can't block the request
    that triggered the event. The body is signed with HMAC-SHA256 (the endpoint's secret) in
    the ``X-Webhook-Signature`` header. A non-2xx response or transport error raises ``Retry``
    so arq re-runs it with backoff; each attempt is logged.
    """
    import json
    import uuid

    import httpx
    from arq import Retry

{% if include_audit %}
    from app.audit import record
{% endif %}
{% if include_rls %}
    from app.db.session import PrivilegedSessionFactory as SessionFactory  # worker bypasses RLS
{% else %}
    from app.db.session import SessionFactory
{% endif %}
    from app.webhooks.egress import WebhookEgressError, resolve_pinned_target
    from app.webhooks.models import WebhookEndpoint
    from app.webhooks.security import SIGNATURE_HEADER, sign_payload

    async with SessionFactory() as session:
        endpoint = await session.get(WebhookEndpoint, uuid.UUID(endpoint_id))
        if endpoint is None or not endpoint.active:
            log.warning("webhooks.endpoint_unavailable", endpoint_id=endpoint_id)
            return
        url = endpoint.url
        secret = endpoint.secret
{% if include_audit %}
        organization_id = endpoint.organization_id
{% endif %}

    # SSRF egress guard: resolve + pin the tenant URL to a validated public IP before we POST.
    try:
        target = await resolve_pinned_target(url)
    except WebhookEgressError as exc:
        # Private/metadata target = permanent SSRF risk, not transient — block, don't retry.
        log.warning("webhooks.delivery_blocked_ssrf", endpoint_id=endpoint_id, error=str(exc))
{% if include_audit %}
        async with SessionFactory() as session:
            await record(
                session,
                "webhook.delivery_blocked",
                actor="system",
                target=endpoint_id,
                organization_id=organization_id,
                event_type=event_type,
                reason=str(exc),
            )
            await session.commit()
{% endif %}
        return

    body = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode("utf-8")
    headers = {
        "Content-Type": "application/json",
        "Host": target.host_header,  # vhost routing: we dial the pinned IP, not the hostname
        SIGNATURE_HEADER: f"sha256={sign_payload(secret, body)}",
        "X-Webhook-Event": event_type,
    }
    attempt = ctx.get("job_try", 1)
    log.info("webhooks.delivering", endpoint_id=endpoint_id, event_type=event_type)
    try:
        # follow_redirects=False so a 3xx to an internal host is never chased; sni_hostname keeps
        # TLS verification bound to the real hostname even though we connect to the pinned IP.
        async with httpx.AsyncClient(timeout=10.0, follow_redirects=False) as client:
            response = await client.post(
                target.url,
                content=body,
                headers=headers,
                extensions={"sni_hostname": target.sni_hostname},
            )
        response.raise_for_status()
    except httpx.HTTPError as exc:
        log.warning(
            "webhooks.delivery_failed",
            endpoint_id=endpoint_id,
            attempt=attempt,
            error=str(exc),
        )
{% if include_audit %}
        async with SessionFactory() as session:
            await record(
                session,
                "webhook.delivery_failed",
                actor="system",
                target=endpoint_id,
                organization_id=organization_id,
                event_type=event_type,
                attempt=attempt,
            )
            await session.commit()
{% endif %}
        raise Retry(defer=attempt * 5) from exc
    log.info("webhooks.delivered", endpoint_id=endpoint_id, status=response.status_code)
{% if include_audit %}
    async with SessionFactory() as session:
        await record(
            session,
            "webhook.delivered",
            actor="system",
            target=endpoint_id,
            organization_id=organization_id,
            event_type=event_type,
            status=response.status_code,
        )
        await session.commit()
{% endif %}


async def relay_outbox(ctx: dict[str, Any]) -> int:
    """Drain the transactional outbox: publish pending events to their subscribed endpoints.

    The scheduled counterpart of :func:`app.webhooks.dispatch.dispatch` — the worker cron runs it
    frequently so delivery stays low-latency while remaining crash-safe (the event is already
    durable; this only publishes it). Safe to run concurrently. Returns the number published.
    """
{% if include_rls %}
    from app.db.session import PrivilegedSessionFactory as SessionFactory  # relay bypasses RLS
{% else %}
    from app.db.session import SessionFactory
{% endif %}
    from app.jobs.queue import enqueue
    from app.webhooks.outbox import drain_outbox

    async with SessionFactory() as session:
        return await drain_outbox(session, enqueue_fn=enqueue)
{% endif %}
