"""Async SQLAlchemy 2.0 session factory. Requires the `db` extra.

Import errors here are intentional if `db` is not installed — only import this
module from code paths that need the database.
"""

from __future__ import annotations

from collections.abc import AsyncIterator

{% if include_rls %}
from sqlalchemy import event, text
{% endif %}
from sqlalchemy.ext.asyncio import (
    AsyncSession,
    async_sessionmaker,
    create_async_engine,
)
{% if include_rls %}
from sqlalchemy.orm import Session
{% endif %}

from app.core.config import get_settings
{% if include_rls %}
from app.core.logging import get_logger
from app.tenancy.rls import current_tenant_id
{% endif %}

_settings = get_settings()
if not _settings.database_url:
    raise RuntimeError("DATABASE_URL is required to use app.db.session")

{% if include_rls %}
# Primary connection. With RLS on, the per-tenant request path uses this via `get_session`, which
# sets the `app.current_tenant` GUC so Row-Level Security scopes every query to the caller's org.
{% endif %}
engine = create_async_engine(_settings.database_url, pool_pre_ping=True)
{% if include_rls %}
# `info` tags which RLS discipline a session follows; the after_begin hook below reads it.
SessionFactory = async_sessionmaker(engine, expire_on_commit=False, info={"rls_mode": "tenant"})
{% else %}
SessionFactory = async_sessionmaker(engine, expire_on_commit=False)
{% endif %}
{% if include_rls %}

# Trusted connection for cross-tenant flows that legitimately have no single tenant context —
# API-key authentication, the admin panel, inbound provider webhooks, and background workers. It
# connects as a role that BYPASSES RLS (set DATABASE_URL_PRIVILEGED to a BYPASSRLS / owner role in
# production; in dev it falls back to the primary connection). The two-role split is what keeps the
# RLS path a true backstop — the RLS role *cannot* read across tenants even if a query forgets its
# WHERE clause, while these trusted flows are never silently blocked. See app/tenancy/rls.py.
privileged_engine = create_async_engine(
    _settings.database_url_privileged or _settings.database_url, pool_pre_ping=True
)
PrivilegedSessionFactory = async_sessionmaker(
    privileged_engine, expire_on_commit=False, info={"rls_mode": "bypass"}
)


class PrivilegedRoleMisconfigured(RuntimeError):
    """DATABASE_URL_PRIVILEGED connects as a role that does NOT bypass RLS.

    Raised loudly rather than degrading: a non-BYPASSRLS privileged role makes every trusted
    cross-tenant flow (API-key auth, admin, inbound webhooks, workers) silently return zero rows,
    which reads as "the record vanished" instead of "the deployment is misconfigured".
    """


_SET_TENANT = text("SELECT set_config('app.current_tenant', :tenant, true)")
_ROLE_BYPASSES_RLS = text(
    "SELECT rolbypassrls OR rolsuper FROM pg_roles WHERE rolname = current_user"
)
# Checked once per process on first privileged use — it is a deployment property, not a per-request
# one, so paying for it on every request would be waste.
_privileged_role_verified = False
# One-shot trap: a session factory built without an `rls_mode` tag gets NO tenant context. That
# fails CLOSED (zero rows), but silently — so say so, once, rather than leaving it to be discovered
# as "the query returns nothing". The structural check in tests/test_rls.py is the real gate; this
# catches factories created outside the template (a library, or app code added later).
_untagged_factory_warned = False

log = get_logger(__name__)


@event.listens_for(Session, "after_begin")
def _apply_tenant_context(session: Session, transaction: object, connection: object) -> None:
    """Set the RLS tenant GUC at the start of EVERY transaction, transaction-locally.

    The third argument to ``set_config`` is ``true`` — *local* — so Postgres discards the value when
    the transaction ends. That is the whole guardrail: a session-scoped value lives on the physical
    connection, and a transaction-mode pooler (PgBouncer) hands that connection to the next client
    with the previous tenant's context still set. Transaction-local context cannot be inherited,
    and re-applying it per transaction means a request that commits mid-flight keeps working.

    A privileged session explicitly CLEARS the context instead of inheriting whatever the
    connection last carried; it relies on its role's BYPASSRLS, verified in
    :func:`get_privileged_session`.
    """
    if connection.dialect.name != "postgresql":  # type: ignore[attr-defined]
        return
    mode = session.info.get("rls_mode")
    if mode is None:
        global _untagged_factory_warned
        if not _untagged_factory_warned:
            _untagged_factory_warned = True
            log.warning(
                "rls.untagged_session_factory",
                detail=(
                    "a session was opened from a factory with no info['rls_mode']; it runs with NO "
                    "tenant context and RLS will return zero rows for it"
                ),
            )
        return
    tenant = "" if mode == "bypass" else (current_tenant_id.get() or "")
    connection.execute(_SET_TENANT, {"tenant": tenant})  # type: ignore[attr-defined]


async def get_session() -> AsyncIterator[AsyncSession]:
    """Per-tenant (RLS-scoped) DB session; `app.current_tenant` is set per transaction."""
    async with SessionFactory() as session:
        yield session


async def get_privileged_session() -> AsyncIterator[AsyncSession]:
    """Trusted session that BYPASSES RLS — for cross-tenant auth/admin/webhook/worker flows."""
    global _privileged_role_verified
    async with PrivilegedSessionFactory() as session:
        if not _privileged_role_verified and privileged_engine.dialect.name == "postgresql":
            bypasses = (await session.execute(_ROLE_BYPASSES_RLS)).scalar()
            if not bypasses:
                raise PrivilegedRoleMisconfigured(
                    "The privileged database role does not have BYPASSRLS. Set "
                    "DATABASE_URL_PRIVILEGED to a role created with BYPASSRLS (or a superuser); "
                    "it currently falls back to DATABASE_URL, so trusted cross-tenant flows would "
                    "return zero rows instead of failing."
                )
            _privileged_role_verified = True
        yield session
{% else %}


async def get_session() -> AsyncIterator[AsyncSession]:
    """FastAPI dependency: `session: AsyncSession = Depends(get_session)`."""
    async with SessionFactory() as session:
        yield session
{% endif %}
