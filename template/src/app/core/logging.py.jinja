def add_trace_context(
    _logger: object, _method_name: str, event_dict: structlog.typing.EventDict
) -> structlog.typing.EventDict:
    """structlog processor: tag each log line with the active span's trace_id / span_id.

    Enriches (never replaces) the existing output, so a log emitted inside a request or task
    links back to its OpenTelemetry span. A no-op when no span is active.
    """
    ctx = trace.get_current_span().get_span_context()
    if ctx.is_valid:
        event_dict["trace_id"] = format(ctx.trace_id, "032x")
        event_dict["span_id"] = format(ctx.span_id, "016x")
    return event_dict

{% endif %}

REDACTED = "[REDACTED]"


def _scrub(value: object, keys: tuple[str, ...]) -> object:
    """Recursively mask values whose FIELD NAME matches a sentinel, preserving the structure.

    Containers keep their type (a dict stays a dict, a list stays a list) so a scrubbed line is
    still the shape the caller logged; only the sensitive leaves are replaced. Matching is
    case-insensitive substring, so ``token`` covers ``access_token`` and ``refresh_token`` without
    needing every variant enumerated.
    """
    if isinstance(value, dict):
        scrubbed: dict[object, object] = {}
        for key, item in value.items():
            name = str(key).lower()
            if any(sentinel in name for sentinel in keys):
                scrubbed[key] = REDACTED
            else:
                scrubbed[key] = _scrub(item, keys)
        return scrubbed
    if isinstance(value, list):
        return [_scrub(item, keys) for item in value]
    if isinstance(value, tuple):
        return tuple(_scrub(item, keys) for item in value)
    return value


def scrub_sensitive(
    _logger: object, _method: str, event_dict: structlog.typing.EventDict
) -> structlog.typing.EventDict:
    """structlog processor: redact sensitive values before anything renders them.

    Placed early in the chain, ahead of every renderer, so no formatting path can bypass it —
    including the console renderer used in development, where a leaked value is just as leaked.
    """
    keys = tuple(key.lower() for key in get_settings().log_scrub_keys)
    if not keys:
        return event_dict
    return _scrub(event_dict, keys)  # type: ignore[return-value]


def configure_logging() -> None:
    """Configure structlog: shared processors, level, and JSON-vs-console rendering."""
    settings = get_settings()
    level = logging.DEBUG if settings.debug else logging.INFO

    shared_processors: list[structlog.typing.Processor] = [
        structlog.contextvars.merge_contextvars,
        # Ahead of every renderer: redaction must not depend on which one is active.
        scrub_sensitive,
        structlog.processors.add_log_level,
        structlog.processors.TimeStamper(fmt="iso"),
        structlog.processors.StackInfoRenderer(),
{% if include_observability %}
        add_trace_context,
{% endif %}
    ]

    if settings.log_json:
        renderer: structlog.typing.Processor = structlog.processors.JSONRenderer()
    else:
        renderer = structlog.dev.ConsoleRenderer()

    structlog.configure(
        processors=[*shared_processors, renderer],
        wrapper_class=structlog.make_filtering_bound_logger(level),
        logger_factory=structlog.PrintLoggerFactory(file=sys.stdout),
        cache_logger_on_first_use=True,
    )


def get_logger(name: str | None = None) -> structlog.stdlib.BoundLogger:
    """Return a bound structlog logger for ``name`` (the module name by convention)."""
    return cast(structlog.stdlib.BoundLogger, structlog.get_logger(name))
