"""Application settings, loaded from environment / .env via pydantic-settings."""

from __future__ import annotations

from functools import lru_cache
from typing import Literal

from pydantic import Field
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        env_nested_delimiter="__",
        extra="ignore",
    )

    # --- App ---
    app_name: str = "witaura-backend"
    environment: Literal["local", "staging", "production"] = "local"
    debug: bool = False
    log_json: bool = Field(default=False, description="Emit structured JSON logs.")

    # --- Server ---
    host: str = "0.0.0.0"
    port: int = 8000
    cors_origins: list[str] = Field(default_factory=lambda: ["*"])

    # --- Datastores (only used if the `db` / `cache` extras are installed) ---
    database_url: str | None = None  # postgresql+asyncpg://user:pass@host:5432/db
    redis_url: str | None = None

    # --- LLM providers (only used if `llm` / an agent extra is installed) ---
    anthropic_api_key: str | None = None
    openai_api_key: str | None = None

    # --- Model cascade: deterministic handler -> RAG -> frontier model.
    #     Defaults favour cost/latency; escalate explicitly for hard tasks.
    model_fast: str = "claude-haiku-4-5-20251001"
    model_default: str = "claude-sonnet-4-6"
    model_frontier: str = "claude-opus-4-8"
{% if include_users or include_tenancy or include_rbac or include_api_keys or include_billing %}

    # --- Users / auth (only used if the `users` extra is installed) ---
    #     Override USERS_JWT_SECRET in every non-local environment (>=32 bytes).
    users_jwt_secret: str = "CHANGE_ME_dev_only_secret_override_in_prod"
    users_jwt_lifetime_seconds: int = 3600
{% endif %}
{% if include_billing %}

    # --- Billing / payments (only used if the `payments` extra is installed) ---
    #     The active provider is swappable: `payments_provider` selects which adapter
    #     `app.billing.provider` returns; the rest of the app speaks only PaymentsPort.
    #     Override PAYMENTS_PROVIDER per environment to switch (default ships as below).
    payments_provider: Literal["stripe", "razorpay"] = "{{ payments_provider }}"
    # Internal entitlements plan a checkout subscribes to when the request omits one.
    payments_default_plan: str = "pro"
    # Provider-agnostic redirect targets for hosted checkout / portal returns.
    payments_success_url: str = "http://localhost:8000/billing/success"
    payments_cancel_url: str = "http://localhost:8000/billing/cancel"
    payments_portal_return_url: str = "http://localhost:8000/billing"

    # Stripe (used when payments_provider == "stripe"). TEST-MODE keys only here; set real
    # keys per environment via env vars. `stripe_plan_to_price` maps each INTERNAL plan key
    # to a Stripe Price id (inverted for webhook price -> plan).
    stripe_secret_key: str | None = None
    stripe_webhook_secret: str | None = None
    stripe_plan_to_price: dict[str, str] = Field(default_factory=dict)

    # Razorpay (used when payments_provider == "razorpay"; India-first). `razorpay_plan_to_
    # plan_id` maps each INTERNAL plan key to a Razorpay Plan id. Razorpay has no hosted
    # portal, so `razorpay_portal_url` is where customers manage their subscription.
    razorpay_key_id: str | None = None
    razorpay_key_secret: str | None = None
    razorpay_webhook_secret: str | None = None
    razorpay_portal_url: str = "http://localhost:8000/billing"
    razorpay_plan_to_plan_id: dict[str, str] = Field(default_factory=dict)
    # Number of billing cycles a Razorpay subscription runs for (required by its API).
    razorpay_total_count: int = 12
{% endif %}
{% if include_storage %}

    # --- Object storage (S3-compatible; only used if the `storage` extra is installed) ---
    #     Works with AWS S3 or any S3-compatible endpoint (MinIO, R2, ...). Set credentials
    #     per environment via env vars, never hard-coded; leave `s3_endpoint_url=None` for AWS.
    s3_endpoint_url: str | None = None
    s3_bucket: str | None = None
    s3_region: str = "us-east-1"
    s3_access_key_id: str | None = None
    s3_secret_access_key: str | None = None
    s3_presign_expiry_seconds: int = 3600
{% endif %}

    @property
    def is_production(self) -> bool:
        return self.environment == "production"


@lru_cache
def get_settings() -> Settings:
    """Cached singleton — import this everywhere instead of constructing Settings()."""
    return Settings()
