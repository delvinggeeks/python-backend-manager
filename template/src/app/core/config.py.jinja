"""Application settings, loaded from environment / .env via pydantic-settings."""

from __future__ import annotations

from functools import lru_cache
from typing import Literal

from pydantic import Field
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Application settings, loaded from environment / .env (cached via get_settings)."""

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        env_nested_delimiter="__",
        extra="ignore",
    )

    # --- App ---
    app_name: str = "witaura-backend"
    environment: Literal["local", "staging", "production"] = "local"
    debug: bool = False
    log_json: bool = Field(default=False, description="Emit structured JSON logs.")

    # --- Server ---
    host: str = "0.0.0.0"  # noqa: S104  (binding all interfaces is intentional in a container)
    port: int = 8000
    # Locked down by default: no cross-origin browser access until you list trusted origins
    # explicitly (e.g. CORS_ORIGINS=["https://app.example.com"]). Server/mobile clients are
    # unaffected — CORS is browser-only. (A "*" origin with credentials is invalid anyway.)
    cors_origins: list[str] = Field(default_factory=list)

    # --- Security headers (safe-by-default; added to every response by the middleware) ---
    #     Set SECURITY_HEADERS_ENABLED=false only if an edge proxy adds them. HSTS is sent
    #     only in production (it needs HTTPS). The default CSP only forbids framing (anti-
    #     clickjacking), so it never breaks /docs or /admin; tighten per service if you serve HTML.
    security_headers_enabled: bool = True
    security_csp: str = "frame-ancestors 'none'"
    security_hsts_max_age: int = 63072000  # 2 years, in seconds

    # --- Datastores (only used if the `db` / `cache` extras are installed) ---
    database_url: str | None = None  # postgresql+asyncpg://user:pass@host:5432/db
    redis_url: str | None = None

    # --- LLM providers (only used if `llm` / an agent extra is installed) ---
    anthropic_api_key: str | None = None
    openai_api_key: str | None = None

    # --- Model cascade: deterministic handler -> RAG -> frontier model.
    #     Defaults favour cost/latency; escalate explicitly for hard tasks.
    model_fast: str = "claude-haiku-4-5-20251001"
    model_default: str = "claude-sonnet-4-6"
    model_frontier: str = "claude-opus-4-8"
{% if include_users or include_tenancy or include_rbac or include_api_keys or include_billing or include_webhooks or include_admin %}

    # --- Users / auth (only used if the `users` extra is installed) ---
    #     Override USERS_JWT_SECRET in every non-local environment (>=32 bytes).
    users_jwt_secret: str = "CHANGE_ME_dev_only_secret_override_in_prod"  # noqa: S105
    # Short-lived access token; clients exchange the rotating refresh token below for a new one.
    users_jwt_lifetime_seconds: int = 900
    # Rotating refresh-token lifetime (30 days); each /auth/jwt/refresh rotates and re-issues it.
    users_refresh_lifetime_seconds: int = 2592000
{% endif %}
{% if include_billing %}

    # --- Billing / payments (only used if the `payments` extra is installed) ---
    #     The active provider is swappable: `payments_provider` selects which adapter
    #     `app.billing.provider` returns; the rest of the app speaks only PaymentsPort.
    #     Override PAYMENTS_PROVIDER per environment to switch (default ships as below).
    payments_provider: Literal["stripe", "razorpay"] = "{{ payments_provider }}"
    # Internal entitlements plan a checkout subscribes to when the request omits one.
    payments_default_plan: str = "pro"
    # Provider-agnostic redirect targets for hosted checkout / portal returns.
    payments_success_url: str = "http://localhost:8000/billing/success"
    payments_cancel_url: str = "http://localhost:8000/billing/cancel"
    payments_portal_return_url: str = "http://localhost:8000/billing"

    # Stripe (used when payments_provider == "stripe"). TEST-MODE keys only here; set real
    # keys per environment via env vars. `stripe_plan_to_price` maps each INTERNAL plan key
    # to a Stripe Price id (inverted for webhook price -> plan).
    stripe_secret_key: str | None = None
    stripe_webhook_secret: str | None = None
    stripe_plan_to_price: dict[str, str] = Field(default_factory=dict)

    # Razorpay (used when payments_provider == "razorpay"; India-first). `razorpay_plan_to_
    # plan_id` maps each INTERNAL plan key to a Razorpay Plan id. Razorpay has no hosted
    # portal, so `razorpay_portal_url` is where customers manage their subscription.
    razorpay_key_id: str | None = None
    razorpay_key_secret: str | None = None
    razorpay_webhook_secret: str | None = None
    razorpay_portal_url: str = "http://localhost:8000/billing"
    razorpay_plan_to_plan_id: dict[str, str] = Field(default_factory=dict)
    # Number of billing cycles a Razorpay subscription runs for (required by its API).
    razorpay_total_count: int = 12
{% endif %}
{% if include_storage %}

    # --- Object storage (S3-compatible; only used if the `storage` extra is installed) ---
    #     Works with AWS S3 or any S3-compatible endpoint (MinIO, R2, ...). Set credentials
    #     per environment via env vars, never hard-coded; leave `s3_endpoint_url=None` for AWS.
    s3_endpoint_url: str | None = None
    s3_bucket: str | None = None
    s3_region: str = "us-east-1"
    s3_access_key_id: str | None = None
    s3_secret_access_key: str | None = None
    s3_presign_expiry_seconds: int = 3600
{% endif %}
{% if include_email %}

    # --- Email / notifications (only used if the `email` extra is installed) ---
    #     Provider-agnostic: `email_provider` selects the adapter `app.email.provider` returns;
    #     the app speaks only EmailPort. Override EMAIL_PROVIDER per environment; set
    #     EMAIL_SUPPRESS_SEND=true (or EMAIL_PROVIDER=console) so nothing actually sends in dev.
    email_provider: Literal["smtp", "ses", "console"] = "{{ email_provider }}"
    email_suppress_send: bool = False
    email_from_address: str = "no-reply@localhost"
    email_from_name: str = "{{ project_name }}"

    # SMTP (used when email_provider == "smtp"; e.g. Zoho / Microsoft 365). STARTTLS on 587.
    # Unconfigured (no SMTP_HOST) -> nothing sends, so a dev env never blocks on email.
    smtp_host: str | None = None
    smtp_port: int = 587
    smtp_username: str | None = None
    smtp_password: str | None = None
    smtp_start_tls: bool = True
    smtp_use_tls: bool = False

    # Amazon SES via the AWS API (used when email_provider == "ses"; pairs with S3 storage).
    # Unconfigured (no access keys) -> nothing sends. Leave `ses_endpoint_url=None` for AWS.
    ses_region: str = "us-east-1"
    ses_access_key_id: str | None = None
    ses_secret_access_key: str | None = None
    ses_endpoint_url: str | None = None
{% endif %}
{% if include_observability %}

    # --- Observability (only used if the `observability` extra is installed) ---
    #     The three pillars export over OTLP, but only once OTEL_EXPORTER_OTLP_ENDPOINT is set
    #     (e.g. http://localhost:4318) — a fresh service runs clean with no collector. Sentry is
    #     optional too: no SENTRY_DSN -> error reporting no-ops (same pattern as email / jobs).
    otel_exporter_otlp_endpoint: str | None = None
    otel_service_name: str | None = None  # defaults to app_name when unset
    sentry_dsn: str | None = None
    sentry_traces_sample_rate: float = 0.0
{% endif %}

    @property
    def is_production(self) -> bool:
        return self.environment == "production"


@lru_cache
def get_settings() -> Settings:
    """Cached singleton — import this everywhere instead of constructing Settings()."""
    return Settings()
