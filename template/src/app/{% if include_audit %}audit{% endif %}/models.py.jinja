"""The audit-log table — append-only; rows are never updated or deleted.

Mapped onto the shared ``Base`` from ``app.db.models`` so a single ``Base.metadata`` covers
the whole service. ``organization_id`` is present only when the tenancy module ships, so the
same log is org-scoped in a multi-tenant service and flat otherwise.
"""

from __future__ import annotations

import uuid
from datetime import datetime
from typing import Any

{% if include_tenancy or include_rbac or include_api_keys or include_billing or include_webhooks %}
# Load fastapi_users.db before the adapter's `generics` submodule (import-ordering guard,
# mirrors app.tenancy.models) so the GUID type imports cleanly. The id reuses the tenancy GUID
# so ``organization_id`` can foreign-key ``organizations.id`` with a matching column type.
import fastapi_users.db  # noqa: F401  (import-ordering guard)
from fastapi_users_db_sqlalchemy.generics import GUID
from sqlalchemy import JSON, ForeignKey, String, func
{% else %}
# No tenancy here, so fastapi-users isn't a dependency — use SQLAlchemy's native UUID type.
from sqlalchemy import JSON, String, func
from sqlalchemy import Uuid as GUID
{% endif %}
from sqlalchemy.orm import Mapped, mapped_column

from app.db.models import Base


class AuditLog(Base):
    """An immutable audit event. There is deliberately no update/delete code path for it."""

    __tablename__ = "audit_logs"

    id: Mapped[uuid.UUID] = mapped_column(GUID, primary_key=True, default=uuid.uuid4)
{% if include_tenancy or include_rbac or include_api_keys or include_billing or include_webhooks %}
    organization_id: Mapped[uuid.UUID | None] = mapped_column(
        GUID, ForeignKey("organizations.id", ondelete="CASCADE"), index=True, default=None
    )
{% endif %}
    actor: Mapped[str | None] = mapped_column(String(255), default=None)
    action: Mapped[str] = mapped_column(String(255), index=True)
    target: Mapped[str | None] = mapped_column(String(255), default=None)
    # Attribute is ``meta`` because SQLAlchemy reserves ``metadata`` on the declarative base;
    # the underlying database column is still named ``metadata``.
    meta: Mapped[dict[str, Any] | None] = mapped_column("metadata", JSON, default=None)
    created_at: Mapped[datetime] = mapped_column(server_default=func.now(), index=True)
