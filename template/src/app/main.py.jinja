"""FastAPI application factory."""

from __future__ import annotations
{% if include_mcp %}

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
{% endif %}

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from app import __version__
from app.api.router import api_router
from app.core.config import get_settings
from app.core.lifespan import lifespan
{% if include_mcp %}
from app.mcp_server import mcp_app


@asynccontextmanager
async def _combined_lifespan(app: FastAPI) -> AsyncIterator[None]:
    # Enter BOTH the service lifespan and FastMCP's session-manager lifespan.
    # FastMCP's streamable-http transport requires its lifespan to run, so we
    # nest them here instead of replacing app.core.lifespan.
    async with lifespan(app), mcp_app.lifespan(app):
        yield
{% endif %}


def create_app() -> FastAPI:
    settings = get_settings()
    app = FastAPI(
        title=settings.app_name,
        version=__version__,
        debug=settings.debug,
        lifespan={% if include_mcp %}_combined_lifespan{% else %}lifespan{% endif %},
    )
    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.cors_origins,
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )
    app.include_router(api_router)
{% if include_mcp %}
    app.mount("/mcp", mcp_app)
{% endif %}
{% if include_users or include_tenancy or include_rbac or include_api_keys %}
    # Imported here, not at module top, so `app.main` can be imported without a
    # configured DATABASE_URL — the user-DB engine is built when the app is created.
    from app.users import auth_backend, fastapi_users
    from app.users.schemas import UserCreate, UserRead, UserUpdate

    app.include_router(
        fastapi_users.get_auth_router(auth_backend), prefix="/auth/jwt", tags=["auth"]
    )
    app.include_router(
        fastapi_users.get_register_router(UserRead, UserCreate),
        prefix="/auth",
        tags=["auth"],
    )
    app.include_router(fastapi_users.get_reset_password_router(), prefix="/auth", tags=["auth"])
    app.include_router(fastapi_users.get_verify_router(UserRead), prefix="/auth", tags=["auth"])
    app.include_router(
        fastapi_users.get_users_router(UserRead, UserUpdate),
        prefix="/users",
        tags=["users"],
    )
{% endif %}
{% if include_tenancy or include_rbac or include_api_keys %}
    from app.tenancy.router import router as tenancy_router

    app.include_router(tenancy_router, prefix="/orgs", tags=["organizations"])
{% endif %}
{% if include_api_keys %}
    from app.api_keys.router import identity_router
    from app.api_keys.router import router as api_keys_router

    app.include_router(api_keys_router, prefix="/orgs", tags=["api-keys"])
    app.include_router(identity_router, tags=["identity"])
{% endif %}
    return app


app = create_app()
