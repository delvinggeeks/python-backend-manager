"""FastAPI application factory."""

from __future__ import annotations
{% if include_mcp %}

from collections.abc import AsyncIterator
from contextlib import asynccontextmanager
{% endif %}

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from app import __version__
from app.api.router import api_router
from app.core.config import get_settings
from app.core.lifespan import lifespan
from app.core.middleware import SecurityHeadersMiddleware
{% if include_mcp %}
from app.mcp_server import mcp_app


@asynccontextmanager
async def _combined_lifespan(app: FastAPI) -> AsyncIterator[None]:
    # Enter BOTH the service lifespan and FastMCP's session-manager lifespan.
    # FastMCP's streamable-http transport requires its lifespan to run, so we
    # nest them here instead of replacing app.core.lifespan.
    async with lifespan(app), mcp_app.lifespan(app):
        yield
{% endif %}


def create_app() -> FastAPI:
    """Build and configure the FastAPI app: middleware, routers, and lifespan."""
    settings = get_settings()
    app = FastAPI(
        title=settings.app_name,
        version=__version__,
        debug=settings.debug,
        lifespan={% if include_mcp %}_combined_lifespan{% else %}lifespan{% endif %},
    )
    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.cors_origins,
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )
    if settings.security_headers_enabled:
        app.add_middleware(
            SecurityHeadersMiddleware,
            csp=settings.security_csp,
            hsts_max_age=settings.security_hsts_max_age,
            include_hsts=settings.is_production,
        )
    app.include_router(api_router)
{% if include_mcp %}
    app.mount("/mcp", mcp_app)
{% endif %}
{% if include_users or include_tenancy or include_rbac or include_api_keys or include_billing or include_webhooks or include_admin %}
    # Imported here, not at module top, so `app.main` can be imported without a
    # configured DATABASE_URL — the user-DB engine is built when the app is created.
    from app.users import auth_router, fastapi_users
    from app.users.schemas import UserCreate, UserRead, UserUpdate

    # Custom JWT router (login / refresh / logout / logout-all) — replaces fastapi-users' built-in
    # login so a rotating refresh token is issued alongside the short-lived access token.
    app.include_router(auth_router, prefix="/auth/jwt", tags=["auth"])
    app.include_router(
        fastapi_users.get_register_router(UserRead, UserCreate),
        prefix="/auth",
        tags=["auth"],
    )
    app.include_router(fastapi_users.get_reset_password_router(), prefix="/auth", tags=["auth"])
    app.include_router(fastapi_users.get_verify_router(UserRead), prefix="/auth", tags=["auth"])
    app.include_router(
        fastapi_users.get_users_router(UserRead, UserUpdate),
        prefix="/users",
        tags=["users"],
    )
{% endif %}
{% if include_tenancy or include_rbac or include_api_keys or include_billing or include_webhooks %}
    from app.tenancy.router import router as tenancy_router

    app.include_router(tenancy_router, prefix="/orgs", tags=["organizations"])
{% endif %}
{% if include_api_keys %}
    from app.api_keys.router import identity_router
    from app.api_keys.router import router as api_keys_router

    app.include_router(api_keys_router, prefix="/orgs", tags=["api-keys"])
    app.include_router(identity_router, tags=["identity"])
{% endif %}
{% if include_billing %}
    from app.billing.router import router as billing_router
    from app.billing.router import webhook_router as billing_webhook_router

    app.include_router(billing_router, prefix="/orgs", tags=["billing"])
    app.include_router(billing_webhook_router, prefix="/billing", tags=["billing"])
{% endif %}
{% if include_audit %}
    from app.audit.router import router as audit_router

    # Mounted at its full path (org-scoped when tenancy is on, flat otherwise), so no prefix.
    app.include_router(audit_router, tags=["audit"])
{% endif %}
{% if include_webhooks %}
    from app.webhooks.router import router as webhooks_router

    app.include_router(webhooks_router, tags=["webhooks"])
{% endif %}
{% if include_storage %}
    from app.storage.router import router as storage_router

{% if include_tenancy or include_rbac or include_api_keys or include_billing or include_webhooks %}
    # Org-scoped: keys are tenant-prefixed and routes reuse the membership dependency.
    app.include_router(storage_router, prefix="/orgs", tags=["storage"])
{% else %}
    app.include_router(storage_router, prefix="/storage", tags=["storage"])
{% endif %}
{% endif %}
{% if include_observability %}
    # Wired at construction (instrumentation middleware must be added before the app serves);
    # the matching flush runs on shutdown in app.core.lifespan. Instruments FastAPI + httpx
    # (+ SQLAlchemy/redis when present), mounts /healthz, /readyz and /metrics, and starts OTLP
    # export only when OTEL_EXPORTER_OTLP_ENDPOINT is set. Sentry inits here too (no-op w/o DSN).
    from app.observability import setup_observability

    setup_observability(app)
{% endif %}
{% if include_admin %}
    # Mount the sqladmin control panel at /admin, gated behind superuser-only auth. Imported
    # here (not at module top) so `app.main` imports without a configured DATABASE_URL — the
    # admin binds the db engine when the app is created.
    from app.admin import mount_admin

    mount_admin(app)
{% endif %}
    return app


app = create_app()
