# {{ project_name }} — task runner. Install just: `uv tool install rust-just`
set dotenv-load := true

default:
    @just --list

# Install venv + this service's default extras + dev deps
setup:
    uv sync{% for e in sync_extras.split() %} --extra {{ e }}{% endfor %}

run:
    uv run uvicorn app.main:app --reload --host 0.0.0.0 --port ${PORT:-8000}

test:
    uv run pytest

# OpenAPI fuzzing (Schemathesis): boot the app and assert no endpoint 5xxes under
# schema-aware property-based fuzzing. Needs the app's extras synced (`just setup`).
fuzz:
    bash scripts/run_fuzz.sh

lint:
    uv run ruff check .

fmt:
    uv run ruff format .
    uv run ruff check --fix .

typecheck:
    uv run mypy src

check: lint typecheck test

# LAYER 1: refresh the lockfile to latest compatible library versions
upgrade:
    uv lock --upgrade

outdated:
    uv pip list --outdated

lock:
    uv lock

# LAYER 2: pull the latest version of the template itself into this project
template-update:
    uvx copier update --trust

docker-build:
    docker build -t {{ project_slug }} .

docker-up:
    docker compose up --build
{% if include_observability %}

# Local observability stack: OTel Collector + Prometheus + Tempo + Loki + Grafana (three
# pillars). Grafana (pre-provisioned) -> http://localhost:3000. Wire the app up by setting
# OTEL_EXPORTER_OTLP_ENDPOINT in .env: http://otel-collector:4318 for the compose `api`, or
# http://localhost:4318 for `just run` on the host.
observe:
    docker compose --profile observability up
{% endif %}
{% if include_jobs or include_webhooks %}

# Background worker (arq) — processes the jobs queue + runs the cron schedule.
# Needs Redis (REDIS_URL); run it alongside `just run`.
worker:
    uv run arq app.jobs.worker.WorkerSettings
{% endif %}
{% if include_db or include_users or include_api_keys or include_billing or include_audit or include_webhooks or include_admin %}

# Database migrations (Alembic) — DB-backed services only.
# New migration from model changes, e.g. `just migration "add user table"`
migration message:
    uv run alembic revision --autogenerate -m "{{ '{{ message }}' }}"

# Apply all pending migrations (run before serving)
migrate:
    uv run alembic upgrade head

# Roll the most recent migration back
migrate-down:
    uv run alembic downgrade -1
{% endif %}
